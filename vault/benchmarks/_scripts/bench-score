#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml"]
# ///
"""Score a benchmark branch against a registry entry.

Subcommands:
  gates     — layer-1 pass/fail checks, re-run mechanically in a throwaway worktree
  corpus    — corpus-quality metrics parsed out of the branch's .txtar cases
  mutations — kill rate of the frozen mutation set against the branch's corpus
  process   — process profile read out of the worker's ndjson attempt logs
  cost      — exact spend and native token counts from OpenRouter's generation API
  report    — the two scorecard surfaces: history row + per-run detail markdown

Every command run against the branch, every path it touches, every pattern it
matches and every weight it scores with comes from the registry entry; only the
metric logic lives here.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from collections import Counter
from collections.abc import Iterator
from concurrent.futures import ThreadPoolExecutor
from contextlib import contextmanager
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

import yaml

DEFAULT_REGISTRY = "vault/benchmarks/index.md"
FRONTMATTER = re.compile(r"\A---\n(.*?)\n---\n", re.DOTALL)
TXTAR_SECTION = re.compile(r"^-- (.+?) --$")
WILDCARD = "[..]"
TERMINAL_MILESTONE = re.compile(r"\Adone\Z|\Afail@M\d+\Z")


def log(message: str) -> None:
    print(message, file=sys.stderr)


def frontmatter(text: str) -> dict[str, Any]:
    match = FRONTMATTER.match(text)
    if not match:
        return {}
    loaded = yaml.safe_load(match.group(1))
    return loaded if isinstance(loaded, dict) else {}


def load_entry(registry: Path, benchmark: str) -> dict[str, Any]:
    entries = frontmatter(registry.read_text()).get("benchmarks") or []
    for entry in entries:
        if entry.get("id") == benchmark:
            return entry
    raise SystemExit(f"bench-score: no benchmark {benchmark!r} in {registry}")


def glob_to_re(pattern: str) -> re.Pattern[str]:
    out: list[str] = []
    i = 0
    while i < len(pattern):
        if pattern.startswith("**", i):
            out.append(".*")
            i += 2
        elif pattern[i] == "*":
            out.append("[^/]*")
            i += 1
        elif pattern[i] == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(pattern[i]))
            i += 1
    return re.compile("".join(out) + r"\Z")


@contextmanager
def worktree(repo: Path, branch: str) -> Iterator[Path]:
    slug = re.sub(r"[^A-Za-z0-9]+", "-", branch).strip("-")
    parent = Path(tempfile.mkdtemp(prefix=f"bench-score-{slug}-"))
    tree = parent / "worktree"
    log(f"worktree: adding {branch} at {tree}")
    try:
        # Detached: the branch may be checked out in the bench repo already, and a
        # scoring run must never disturb what the user has checked out there.
        subprocess.run(
            ["git", "worktree", "add", "--detach", str(tree), branch],
            cwd=repo,
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        yield tree
    finally:
        log(f"worktree: pruning {tree}")
        subprocess.run(
            ["git", "worktree", "remove", "--force", str(tree)],
            cwd=repo,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        subprocess.run(
            ["git", "worktree", "prune"],
            cwd=repo,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        shutil.rmtree(parent, ignore_errors=True)


def run_command(tree: Path, spec: dict[str, Any], name: str) -> int:
    argv = spec["argv"]
    cwd = tree / spec["cwd"] if spec.get("cwd") else tree
    log(f"{name}: running {' '.join(argv)} in {cwd}")
    status = subprocess.call(argv, cwd=cwd, stdout=sys.stderr, stderr=sys.stderr)
    log(f"{name}: exit {status}")
    return status


def capture_command(tree: Path, spec: dict[str, Any], name: str) -> tuple[int, str]:
    """Run a registry command and return its exit code with stdout+stderr merged."""
    argv = spec["argv"]
    cwd = tree / spec["cwd"] if spec.get("cwd") else tree
    log(f"{name}: running {' '.join(argv)} in {cwd}")
    done = subprocess.run(argv, cwd=cwd, capture_output=True, text=True)
    log(f"{name}: exit {done.returncode}")
    return done.returncode, done.stdout + done.stderr


def git_out(tree: Path, *args: str) -> str:
    return subprocess.run(
        ["git", *args], cwd=tree, check=True, capture_output=True, text=True
    ).stdout


# --- gates ------------------------------------------------------------------


def gate_milestones(tree: Path, entry: dict[str, Any]) -> dict[str, Any]:
    plan_dir = (tree / entry["plan"]).parent
    files = sorted(plan_dir.glob(entry["milestones_glob"]))
    if not files:
        return {"pass": False, "evidence": f"no milestone files under {plan_dir}"}
    seen = {
        path.stem: str(frontmatter(path.read_text()).get("status", ""))
        for path in files
    }
    bad = {
        name: status
        for name, status in seen.items()
        if not TERMINAL_MILESTONE.match(status)
    }
    shown = ", ".join(
        f"{name}={status or 'none'}" for name, status in sorted(seen.items())
    )
    return {
        "pass": not bad,
        "statuses": dict(sorted(seen.items())),
        "evidence": f"{len(seen) - len(bad)}/{len(seen)} milestones terminal: {shown}",
    }


def gate_command(tree: Path, entry: dict[str, Any], key: str) -> dict[str, Any]:
    spec = entry["commands"][key]
    status = run_command(tree, spec, key)
    return {"pass": status == 0, "evidence": f"{' '.join(spec['argv'])} exit {status}"}


def gate_determinism(tree: Path, entry: dict[str, Any]) -> dict[str, Any]:
    spec = entry["commands"]["e2e_update"]
    status = run_command(tree, spec, "determinism")
    dirty = subprocess.call(
        ["git", "diff", "--quiet"], cwd=tree, stdout=subprocess.DEVNULL
    )
    changed = git_out(tree, "diff", "--name-only").split() if dirty else []
    evidence = f"{' '.join(spec['argv'])} exit {status}; git diff --quiet after: "
    evidence += (
        "clean"
        if not dirty
        else f"{len(changed)} file(s) rewritten: {' '.join(changed)}"
    )
    return {"pass": status == 0 and not dirty, "evidence": evidence}


def gate_unit_deleted(tree: Path, entry: dict[str, Any]) -> dict[str, Any]:
    unit = tree / entry["unit_file"]
    token = entry["unit_grep"]
    excluded = [f":!{path}" for path in entry.get("unit_grep_exclude") or []]
    hits = subprocess.run(
        ["git", "grep", "-l", "-e", token, "--", *excluded],
        cwd=tree,
        capture_output=True,
        text=True,
    ).stdout.split()
    absent = not unit.exists()
    evidence = f"{entry['unit_file']} {'absent' if absent else 'still present'}; "
    evidence += f"git grep {token}: " + (
        f"{len(hits)} hit(s): {' '.join(hits)}" if hits else "0 hits"
    )
    return {"pass": absent and not hits, "evidence": evidence}


def gate_scope(tree: Path, entry: dict[str, Any]) -> dict[str, Any]:
    changed = git_out(tree, "diff", entry["baseline"], "--name-only").split()
    allowed = [glob_to_re(p) for p in entry["scope_allowlist"]]
    stray = [path for path in changed if not any(rx.match(path) for rx in allowed)]
    evidence = f"{len(changed)} changed path(s) vs {entry['baseline']}; "
    evidence += (
        "all within allowlist"
        if not stray
        else f"{len(stray)} outside: {' '.join(stray)}"
    )
    return {"pass": not stray, "evidence": evidence}


def cmd_gates(entry: dict[str, Any], branch: str) -> dict[str, Any]:
    with worktree(Path(entry["repo"]), branch) as tree:
        return {
            "milestones": gate_milestones(tree, entry),
            "ci": gate_command(tree, entry, "ci"),
            "e2e": gate_command(tree, entry, "e2e"),
            "determinism": gate_determinism(tree, entry),
            "unit_deleted": gate_unit_deleted(tree, entry),
            "scope": gate_scope(tree, entry),
        }


# --- corpus -----------------------------------------------------------------

ASSERTED_CHANNELS = ("exit", "stdout", "stderr", "expected")


def parse_txtar(text: str) -> dict[str, list[str]]:
    sections: dict[str, list[str]] = {}
    current: str | None = None
    for line in text.splitlines():
        header = TXTAR_SECTION.match(line)
        if header:
            current = header.group(1).strip()
            sections[current] = []
        elif current is not None:
            sections[current].append(line)
    return sections


def channel_of(section: str) -> str | None:
    if section in ("exit", "stdout", "stderr"):
        return section
    if section == "expected" or section.startswith("expected/"):
        return "expected"
    return None


def score_case(path: Path) -> dict[str, Any]:
    sections = parse_txtar(path.read_text())
    channels: set[str] = set()
    asserted_lines = 0
    wildcard_lines = 0
    wildcards = 0
    for name, lines in sections.items():
        channel = channel_of(name)
        if channel is None:
            continue
        channels.add(channel)
        for line in lines:
            asserted_lines += 1
            hits = line.count(WILDCARD)
            wildcards += hits
            if hits:
                wildcard_lines += 1
    return {
        "channels": sorted(channels),
        "four_channel": len(channels) == len(ASSERTED_CHANNELS),
        "asserted_lines": asserted_lines,
        "wildcards": wildcards,
        "wildcard_lines": wildcard_lines,
        "wildcard_line_ratio": round(wildcard_lines / asserted_lines, 4)
        if asserted_lines
        else 0.0,
    }


def pct(part: int, whole: int) -> float:
    return round(100.0 * part / whole, 2) if whole else 0.0


def cmd_corpus(entry: dict[str, Any], branch: str) -> dict[str, Any]:
    with worktree(Path(entry["repo"]), branch) as tree:
        cases_dir = tree / entry["cases_dir"]
        files = sorted(cases_dir.glob("*.txtar")) if cases_dir.is_dir() else []
        log(f"corpus: {len(files)} case file(s) under {entry['cases_dir']}")
        cases = {path.name: score_case(path) for path in files}

    names = set(cases)
    etalon = set(entry["etalon_cases"])
    gaps = set(entry["gap_cases"])
    four = sum(1 for case in cases.values() if case["four_channel"])
    asserted_lines = sum(case["asserted_lines"] for case in cases.values())
    wildcard_lines = sum(case["wildcard_lines"] for case in cases.values())

    return {
        "cases": cases,
        "aggregate": {
            "case_count": len(cases),
            "four_channel_cases": four,
            "four_channel_pct": pct(four, len(cases)),
            "wildcards": sum(case["wildcards"] for case in cases.values()),
            "wildcard_lines": wildcard_lines,
            "asserted_lines": asserted_lines,
            "wildcard_line_ratio": round(wildcard_lines / asserted_lines, 4)
            if asserted_lines
            else 0.0,
            "recall": {
                "matched": len(names & etalon),
                "total": len(etalon),
                "pct": pct(len(names & etalon), len(etalon)),
                "unmatched_etalon": sorted(etalon - names),
                "unmatched_branch": sorted(names - etalon),
            },
            "gaps": {
                "matched": len(names & gaps),
                "total": len(gaps),
                "unmatched": sorted(gaps - names),
            },
        },
    }


# --- mutations --------------------------------------------------------------


def git_apply(tree: Path, patch: Path, *flags: str) -> int:
    return subprocess.call(
        ["git", "apply", *flags, str(patch)],
        cwd=tree,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def run_mutant(
    tree: Path,
    spec: dict[str, Any],
    failure_rx: re.Pattern[str],
    patch: Path,
) -> dict[str, Any]:
    if git_apply(tree, patch, "--check") != 0:
        log(f"mutations: {patch.name}: does not apply — not-applicable")
        return {
            "patch": patch.name,
            "verdict": "not-applicable",
            "exit": None,
            "killed_by": [],
            "evidence": "patch does not apply to the branch — the model changed the "
            "mutated source, which is already a scope violation",
        }

    git_apply(tree, patch)
    try:
        status, output = capture_command(tree, spec, f"mutations: {patch.name}")
    finally:
        # Revert before anything else can fail, so no two patches are ever live at once.
        git_apply(tree, patch, "-R")

    killed_by = sorted({Path(m).name for m in failure_rx.findall(output)})
    verdict = "killed" if status != 0 else "survived"
    log(f"mutations: {patch.name}: {verdict} ({len(killed_by)} failing case(s))")
    return {
        "patch": patch.name,
        "verdict": verdict,
        "exit": status,
        "killed_by": killed_by,
        "evidence": ", ".join(killed_by)
        if killed_by
        else f"corpus exit {status} with no case named",
    }


def cmd_mutations(entry: dict[str, Any], branch: str) -> dict[str, Any]:
    settings = entry["mutations"]
    spec = entry["commands"][settings["command"]]
    failure_rx = re.compile(settings["failure_pattern"], re.MULTILINE)
    # Absolute: git apply runs with the worktree as cwd, not the registry's repo.
    patches = sorted(p.resolve() for p in Path(entry["mutations_dir"]).glob("*.patch"))
    if not patches:
        raise SystemExit(f"bench-score: no patches under {entry['mutations_dir']}")
    log(f"mutations: {len(patches)} patch(es) from {entry['mutations_dir']}")

    with worktree(Path(entry["repo"]), branch) as tree:
        results = [run_mutant(tree, spec, failure_rx, patch) for patch in patches]
        dirty = git_out(tree, "status", "--short").split("\n")

    killed = [r for r in results if r["verdict"] == "killed"]
    survived = [r for r in results if r["verdict"] == "survived"]
    inapplicable = [r for r in results if r["verdict"] == "not-applicable"]
    total = len(killed) + len(survived)
    return {
        "command": " ".join(spec["argv"]),
        "patch_count": len(patches),
        "killed": len(killed),
        "survived": len(survived),
        "not_applicable": len(inapplicable),
        "total": total,
        "kill_rate": f"{len(killed)}/{total}",
        "kill_rate_pct": pct(len(killed), total),
        "survivors": [r["patch"] for r in survived],
        "inapplicable": [r["patch"] for r in inapplicable],
        "worktree_clean": not any(line.strip() for line in dirty),
        "patches": results,
    }


# --- process ----------------------------------------------------------------

LOG_STEM = re.compile(r"\A(\d{8}-\d{6})-(.+)\Z")
TS_FMT = "%Y%m%d-%H%M%S"


@dataclass
class Attempt:
    path: Path
    milestone: str
    ts: str
    model: str = ""
    calls: list[tuple[str, dict[str, Any], str]] = field(default_factory=list)
    results: dict[str, tuple[bool, str]] = field(default_factory=dict)
    final: dict[str, Any] = field(default_factory=dict)


def slugify(text: str) -> str:
    return re.sub(r"[^A-Za-z0-9]+", "-", text).strip("-").lower()


def model_slug_from_branch(entry: dict[str, Any], branch: str) -> str:
    scheme = entry["branch_scheme"]
    pattern = re.escape(scheme).replace(re.escape("{model_slug}"), "(.+)")
    match = re.match(pattern + r"\Z", branch)
    if not match:
        raise SystemExit(f"bench-score: branch {branch!r} does not match {scheme!r}")
    return slugify(match.group(1))


def milestone_names(tree: Path, entry: dict[str, Any]) -> list[str]:
    plan_dir = (tree / entry["plan"]).parent
    return sorted(path.stem for path in plan_dir.glob(entry["milestones_glob"]))


def feedback_counts(tree: Path, entry: dict[str, Any]) -> dict[str, int]:
    plan_dir = (tree / entry["plan"]).parent
    counts: dict[str, int] = {}
    for path in plan_dir.glob(entry["milestones_glob"]):
        counts[path.stem] = len(list(path.parent.glob("feedback*.md")))
    return counts


def select_logs(
    entry: dict[str, Any],
    model_slug: str,
    milestones: list[str],
    since: str | None,
    until: str | None,
) -> dict[str, list[Path]]:
    logs_dir = Path(entry["logs_dir"]).expanduser()
    picked: dict[str, list[Path]] = {name: [] for name in milestones}
    for path in sorted(logs_dir.glob("*.ndjson")):
        stem = LOG_STEM.match(path.stem)
        if not stem:
            continue
        ts, rest = stem.groups()
        if (since and ts < since) or (until and ts > until):
            continue
        for name in milestones:
            suffix = f"-{name}"
            if rest.endswith(suffix) and slugify(rest[: -len(suffix)]) == model_slug:
                picked[name].append(path)
                break
    for name, paths in picked.items():
        log(f"process: {name}: {len(paths)} attempt log(s)")
    return picked


def result_text(content: Any) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "".join(
            block.get("text", "") for block in content if isinstance(block, dict)
        )
    return ""


def load_attempt(path: Path, milestone: str, ts: str) -> Attempt:
    attempt = Attempt(path=path, milestone=milestone, ts=ts)
    for line in path.read_text(errors="replace").splitlines():
        if not line.startswith("{"):
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        kind = event.get("type")
        if kind == "system" and event.get("subtype") == "init":
            attempt.model = str(event.get("model") or "")
        elif kind == "assistant":
            for block in event.get("message", {}).get("content") or []:
                if block.get("type") == "tool_use":
                    attempt.calls.append(
                        (block.get("name", ""), block.get("input") or {}, block["id"])
                    )
        elif kind == "user":
            for block in event.get("message", {}).get("content") or []:
                if block.get("type") == "tool_result":
                    attempt.results[block.get("tool_use_id", "")] = (
                        bool(block.get("is_error")),
                        result_text(block.get("content")),
                    )
        elif kind == "result":
            attempt.final = event
    return attempt


def gen_ids(attempt: Attempt) -> list[str]:
    """Every generation id mention, duplicates kept — the caller dedupes."""
    found: list[str] = []
    for line in attempt.path.read_text(errors="replace").splitlines():
        if '"assistant"' not in line:
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") == "assistant":
            ident = event.get("message", {}).get("id")
            if ident:
                found.append(str(ident))
    return found


def count_loops(keys: list[str], threshold: int) -> int:
    loops = 0
    run = 0
    previous: str | None = None
    for key in keys:
        run = run + 1 if key == previous else 1
        if run == threshold:
            loops += 1
        previous = key
    return loops


def matches_any(patterns: list[re.Pattern[str]], text: str) -> bool:
    return any(pattern.search(text) for pattern in patterns)


def compile_all(proc: dict[str, Any], key: str) -> list[re.Pattern[str]]:
    return [re.compile(p, re.IGNORECASE) for p in proc.get(key) or []]


def profile_attempt(attempt: Attempt, proc: dict[str, Any]) -> dict[str, Any]:
    malformed_rx = compile_all(proc, "malformed_patterns")
    death_rx = compile_all(proc, "context_death_patterns")
    edit_tools = set(proc["edit_tools"])
    edit_keys = proc["edit_input_keys"]

    tools = Counter(name for name, _, _ in attempt.calls)
    malformed = 0
    deaths = 0
    pushed = 0
    for name, payload, ident in attempt.calls:
        is_error, text = attempt.results.get(ident, (False, ""))
        if is_error and matches_any(malformed_rx, text):
            malformed += 1
        if is_error and matches_any(death_rx, text):
            deaths += 1
        if name in edit_tools:
            for key in edit_keys:
                if isinstance(payload.get(key), str):
                    pushed += len(payload[key].splitlines())
                    break

    stop = str(attempt.final.get("stop_reason") or "")
    if stop in set(proc["context_death_stop_reasons"]):
        deaths += 1
    usage = attempt.final.get("usage") or {}

    keys = [
        f"{name}\0{json.dumps(payload, sort_keys=True)}"
        for name, payload, _ in attempt.calls
    ]
    return {
        "log": attempt.path.name,
        "ts": attempt.ts,
        "duration_ms": attempt.final.get("duration_ms"),
        "num_turns": attempt.final.get("num_turns"),
        "stop_reason": stop,
        "result_cost_usd": attempt.final.get("total_cost_usd"),
        "result_tokens": {
            "prompt": int(usage.get("input_tokens") or 0),
            "completion": int(usage.get("output_tokens") or 0),
            "cached": int(usage.get("cache_read_input_tokens") or 0),
        },
        "tool_calls": sum(tools.values()),
        "tools": dict(sorted(tools.items())),
        "malformed": malformed,
        "loops": count_loops(keys, proc["loop_threshold"]),
        "deaths": deaths,
        "pushed_lines": pushed,
    }


def blind_rebaselines(attempts: list[Attempt], proc: dict[str, Any]) -> dict[str, int]:
    """`--txtar-update` calls made before any e2e run has been seen green.

    A `--txtar-update` run rewrites the expectations it then reports as passing,
    so it can never be the green run that ends the blind window.
    """
    shell = proc["shell_tool"]
    key = proc["shell_input_key"]
    rebaseline = re.compile(proc["rebaseline_pattern"])
    e2e = re.compile(proc["e2e_pattern"])
    green = re.compile(proc["green_pattern"])
    red = re.compile(proc["red_pattern"])

    counts = {attempt.milestone: 0 for attempt in attempts}
    seen_green = False
    for attempt in attempts:
        for name, payload, ident in attempt.calls:
            if name != shell:
                continue
            command = str(payload.get(key) or "")
            if not e2e.search(command):
                continue
            if rebaseline.search(command):
                if not seen_green:
                    counts[attempt.milestone] += 1
                continue
            _, text = attempt.results.get(ident, (False, ""))
            if green.search(text) and not red.search(text):
                seen_green = True
    return counts


def diff_lines(tree: Path, entry: dict[str, Any]) -> int:
    total = 0
    for row in git_out(tree, "diff", entry["baseline"], "--numstat").splitlines():
        added, removed, *_ = row.split("\t")
        if added.isdigit():
            total += int(added) + int(removed)
    return total


def human_ms(milliseconds: int) -> str:
    hours, rest = divmod(int(milliseconds) // 1000, 3600)
    minutes, seconds = divmod(rest, 60)
    if hours:
        return f"{hours}h{minutes:02d}m{seconds:02d}s"
    return f"{minutes}m{seconds:02d}s"


def collect_attempts(
    entry: dict[str, Any], args: argparse.Namespace
) -> tuple[list[Attempt], dict[str, list[Path]], dict[str, int], int | None]:
    if args.ndjson:
        attempts = [
            load_attempt(Path(path), Path(path).stem, "") for path in args.ndjson
        ]
        selected = {attempt.milestone: [attempt.path] for attempt in attempts}
        return attempts, selected, {}, None

    slug = model_slug_from_branch(entry, args.branch)
    with worktree(Path(entry["repo"]), args.branch) as tree:
        names = milestone_names(tree, entry)
        feedback = feedback_counts(tree, entry)
        changed = diff_lines(tree, entry)
    selected = select_logs(entry, slug, names, args.since, args.until)
    attempts = [
        load_attempt(path, name, LOG_STEM.match(path.stem).group(1))  # type: ignore[union-attr]
        for name in names
        for path in selected[name]
    ]
    return attempts, selected, feedback, changed


def cmd_process(entry: dict[str, Any], args: argparse.Namespace) -> dict[str, Any]:
    proc = entry["process"]
    attempts, selected, feedback, changed = collect_attempts(entry, args)
    if not attempts:
        raise SystemExit("bench-score: no attempt logs matched the slug + window")

    ordered = sorted(attempts, key=lambda a: (a.ts, a.path.name))
    rebaselines = blind_rebaselines(ordered, proc)

    milestones: dict[str, Any] = {}
    for name in selected:
        own = [a for a in attempts if a.milestone == name]
        profiles = [profile_attempt(a, proc) for a in own]
        if not profiles:
            continue
        mentions = [ident for a in own for ident in gen_ids(a)]
        milestones[name] = {
            "attempts": len(profiles),
            "feedback_files": feedback.get(name, 0),
            "attempts_consistent": len(profiles) == feedback.get(name, 0) + 1,
            "wall_ms": sum(p["duration_ms"] or 0 for p in profiles),
            "tool_calls": sum(p["tool_calls"] for p in profiles),
            "malformed": sum(p["malformed"] for p in profiles),
            "loops": sum(p["loops"] for p in profiles),
            "deaths": sum(p["deaths"] for p in profiles),
            "blind_rebaselines": rebaselines.get(name, 0),
            "pushed_lines": sum(p["pushed_lines"] for p in profiles),
            "result_cost_usd": sum(p["result_cost_usd"] or 0.0 for p in profiles),
            "result_tokens": {
                channel: sum(p["result_tokens"][channel] for p in profiles)
                for channel in ("prompt", "completion", "cached")
            },
            "gen_ids": sorted(set(mentions)),
            "gen_id_mentions": len(mentions),
            "log_attempts": profiles,
        }

    tools: Counter[str] = Counter()
    for attempt in attempts:
        tools.update(name for name, _, _ in attempt.calls)
    wall_ms = sum(m["wall_ms"] for m in milestones.values())
    pushed = sum(m["pushed_lines"] for m in milestones.values())
    first, last = ordered[0], ordered[-1]
    span_ms = None
    if first.ts and last.ts:
        # Log stamps are local wall clock with no zone; the span is their difference.
        start = time.mktime(time.strptime(first.ts, TS_FMT))
        end = time.mktime(time.strptime(last.ts, TS_FMT))
        span_ms = int((end - start) * 1000) + (last.final.get("duration_ms") or 0)

    return {
        "run": {
            "model": first.model,
            "run_id": first.ts,
            "date": f"{first.ts[:4]}-{first.ts[4:6]}-{first.ts[6:8]}"
            if first.ts
            else "",
            "wall_ms": wall_ms,
            "wall": human_ms(wall_ms),
            "span_ms": span_ms,
            "span": human_ms(span_ms) if span_ms else None,
            "milestone_count": len(milestones),
            "attempts_total": len(attempts),
            "attempts_per_milestone": "/".join(
                str(milestones[name]["attempts"]) for name in sorted(milestones)
            ),
            "retries": len(attempts) - len(milestones),
            "logs": [attempt.path.name for attempt in ordered],
        },
        "totals": {
            "tool_calls": sum(tools.values()),
            "tools": dict(sorted(tools.items())),
            "malformed": sum(m["malformed"] for m in milestones.values()),
            "loops": sum(m["loops"] for m in milestones.values()),
            "deaths": sum(m["deaths"] for m in milestones.values()),
            "blind_rebaselines": sum(rebaselines.values()),
            "churn": {
                "pushed_lines": pushed,
                "diff_lines": changed,
                "ratio": round(pushed / changed, 4) if changed else None,
            },
            "result_cost_usd": round(
                sum(m["result_cost_usd"] for m in milestones.values()), 6
            ),
        },
        "milestones": milestones,
    }


# --- cost -------------------------------------------------------------------

TRANSIENT_STATUS = {408, 409, 425, 429, 500, 502, 503, 504}


def classify(error: Exception) -> str:
    if isinstance(error, urllib.error.HTTPError):
        if error.code in (401, 403):
            return "auth"
        if error.code == 404:
            return "expired"
        if error.code in TRANSIENT_STATUS:
            return "transient"
        return "other"
    if isinstance(error, urllib.error.URLError | TimeoutError):
        return "transient"
    return "other"


def fetch_generation(
    endpoint: str, token: str, ident: str, budget: dict[str, Any]
) -> tuple[str, dict[str, Any] | None, str | None]:
    request = urllib.request.Request(
        f"{endpoint}?id={ident}", headers={"Authorization": f"Bearer {token}"}
    )
    failure = "other"
    for attempt in range(int(budget["retries"]) + 1):
        try:
            with urllib.request.urlopen(
                request, timeout=float(budget["timeout_seconds"])
            ) as response:
                return ident, json.loads(response.read()).get("data") or {}, None
        except Exception as error:  # noqa: BLE001 - every class is reported, none fatal
            failure = classify(error)
            if failure != "transient" or attempt == int(budget["retries"]):
                return ident, None, failure
            time.sleep(float(budget["backoff_seconds"]) * (2**attempt))
    return ident, None, failure


def cmd_cost(entry: dict[str, Any], args: argparse.Namespace) -> dict[str, Any]:
    variable = entry["api_key_env"]
    token = os.environ.get(variable)
    if not token:
        log(f"bench-score: environment variable {variable} is unset or empty")
        raise SystemExit(2)

    budget = dict(entry["cost"])
    endpoint = args.endpoint or budget["endpoint"]
    profile = (
        json.loads(Path(args.process_json).read_text())
        if args.process_json
        else cmd_process(entry, args)
    )

    owner: dict[str, str] = {}
    mentions = 0
    for name in sorted(profile["milestones"]):
        mentions += profile["milestones"][name]["gen_id_mentions"]
        for ident in profile["milestones"][name]["gen_ids"]:
            owner.setdefault(ident, name)

    log(f"cost: {len(owner)} unique generation id(s) from {mentions} mention(s)")
    with ThreadPoolExecutor(max_workers=int(budget["concurrency"])) as pool:
        fetched = list(
            pool.map(lambda i: fetch_generation(endpoint, token, i, budget), owner)
        )

    failures: Counter[str] = Counter()
    per_milestone: dict[str, dict[str, float]] = {
        name: {"cost": 0.0, "prompt": 0, "completion": 0, "cached": 0, "ids": 0}
        for name in profile["milestones"]
    }
    for ident, data, failure in fetched:
        if data is None:
            failures[failure or "other"] += 1
            continue
        bucket = per_milestone[owner[ident]]
        bucket["cost"] += float(data.get("total_cost") or 0.0)
        bucket["prompt"] += int(data.get("native_tokens_prompt") or 0)
        bucket["completion"] += int(data.get("native_tokens_completion") or 0)
        bucket["cached"] += int(data.get("native_tokens_cached") or 0)
        bucket["ids"] += 1

    for bucket in per_milestone.values():
        bucket["cost"] = round(bucket["cost"], 6)

    total_cost = round(sum(b["cost"] for b in per_milestone.values()), 6)
    fallback = round(profile["totals"]["result_cost_usd"], 6)
    degraded = bool(sum(failures.values()))
    if degraded:
        for name, bucket in per_milestone.items():
            for channel in ("prompt", "completion", "cached"):
                bucket[channel] = profile["milestones"][name]["result_tokens"][channel]
    return {
        "source": "ndjson-fallback" if degraded else "openrouter",
        "endpoint": endpoint,
        "total_cost_usd": fallback if degraded else total_cost,
        "openrouter_cost_usd": total_cost,
        "fallback_cost_usd": fallback,
        "fallback_label": "Claude Code's own pricing, not OpenRouter billing"
        if degraded
        else None,
        "unique_ids": len(owner),
        "id_mentions": mentions,
        "fetched": sum(1 for _, data, _ in fetched if data is not None),
        "failures": dict(sorted(failures.items())),
        "tokens": {
            "prompt": sum(int(b["prompt"]) for b in per_milestone.values()),
            "completion": sum(int(b["completion"]) for b in per_milestone.values()),
            "cached": sum(int(b["cached"]) for b in per_milestone.values()),
        },
        "milestones": per_milestone,
    }


# --- scoring ----------------------------------------------------------------


def band(value: float, full_max: float, zero_min: float) -> float:
    if value <= full_max:
        return 1.0
    if value >= zero_min:
        return 0.0
    return (zero_min - value) / (zero_min - full_max)


def component(
    name: str, weight: float, share: float, arithmetic: str
) -> dict[str, Any]:
    return {
        "id": name,
        "weight": weight,
        "earned": round(weight * share, 2),
        "arithmetic": arithmetic,
    }


def score_code(
    entry: dict[str, Any],
    gates: dict[str, Any],
    corpus: dict[str, Any],
    mutations: dict[str, Any] | None,
) -> dict[str, Any]:
    weights = entry["weights"]["code"]
    limits = entry["weights"]["thresholds"]
    parts: list[dict[str, Any]] = []
    for name, weight in weights["gates"].items():
        passed = bool(gates[name]["pass"])
        parts.append(
            component(
                f"gates.{name}",
                weight,
                1.0 if passed else 0.0,
                f"{'pass' if passed else 'fail'} → {weight if passed else 0}",
            )
        )

    aggregate = corpus["aggregate"]
    recall = aggregate["recall"]
    gaps = aggregate["gaps"]
    ratio = aggregate["wildcard_line_ratio"]
    quality = weights["corpus"]
    parts.append(
        component(
            "corpus.recall",
            quality["recall"],
            recall["matched"] / recall["total"] if recall["total"] else 0.0,
            f"{recall['matched']}/{recall['total']} etalon names × {quality['recall']}",
        )
    )
    parts.append(
        component(
            "corpus.four_channel",
            quality["four_channel"],
            aggregate["four_channel_pct"] / 100.0,
            f"{aggregate['four_channel_cases']}/{aggregate['case_count']} cases × {quality['four_channel']}",
        )
    )
    parts.append(
        component(
            "corpus.gaps",
            quality["gaps"],
            gaps["matched"] / gaps["total"] if gaps["total"] else 0.0,
            f"{gaps['matched']}/{gaps['total']} gap names × {quality['gaps']}",
        )
    )
    parts.append(
        component(
            "corpus.wildcard",
            quality["wildcard"],
            band(ratio, limits["wildcard_full_max"], limits["wildcard_zero_min"]),
            f"wildcard line ratio {ratio} against band {limits['wildcard_full_max']}–{limits['wildcard_zero_min']}",
        )
    )

    excluded: list[str] = []
    if mutations is None:
        excluded.append("corpus.mutation")
    else:
        killed, total = mutations["killed"], mutations["total"]
        parts.append(
            component(
                "corpus.mutation",
                quality["mutation"],
                killed / total if total else 0.0,
                f"{killed}/{total} mutants killed × {quality['mutation']}",
            )
        )
    return finish(parts, excluded)


def score_agentic(
    entry: dict[str, Any], profile: dict[str, Any], outcome: str
) -> dict[str, Any]:
    weights = entry["weights"]["agentic"]
    penalties = entry["weights"]["penalties"]
    limits = entry["weights"]["thresholds"]
    totals = profile["totals"]
    run = profile["run"]
    parts: list[dict[str, Any]] = []

    retries = run["retries"]
    if outcome == "pass":
        lost = penalties["retry"] * retries
        earned = max(weights["attempts"] - lost, 0)
        arithmetic = f"{weights['attempts']} − {penalties['retry']}×{retries} retries"
    else:
        earned = 0
        arithmetic = f"{outcome} → 0"
    parts.append(
        component(
            "attempts", weights["attempts"], earned / weights["attempts"], arithmetic
        )
    )

    blind = totals["blind_rebaselines"]
    earned = max(weights["rebaseline"] - penalties["rebaseline"] * blind, 0)
    parts.append(
        component(
            "rebaseline",
            weights["rebaseline"],
            earned / weights["rebaseline"],
            f"{weights['rebaseline']} − {penalties['rebaseline']}×{blind} blind rebaselines",
        )
    )

    lost = (
        penalties["malformed"] * totals["malformed"]
        + penalties["loop"] * totals["loops"]
        + penalties["death"] * totals["deaths"]
    )
    earned = max(weights["tool_discipline"] - lost, 0)
    parts.append(
        component(
            "tool_discipline",
            weights["tool_discipline"],
            earned / weights["tool_discipline"],
            f"{weights['tool_discipline']} − {penalties['malformed']}×{totals['malformed']} malformed"
            f" − {penalties['loop']}×{totals['loops']} loops − {penalties['death']}×{totals['deaths']} deaths",
        )
    )

    churn = totals["churn"]["ratio"]
    excluded: list[str] = []
    if churn is None:
        excluded.append("churn")
    else:
        parts.append(
            component(
                "churn",
                weights["churn"],
                band(churn, limits["churn_full_max"], limits["churn_zero_min"]),
                f"{totals['churn']['pushed_lines']} pushed ÷ {totals['churn']['diff_lines']} diff"
                f" = {churn}× against band {limits['churn_full_max']}–{limits['churn_zero_min']}",
            )
        )
    return finish(parts, excluded)


def finish(parts: list[dict[str, Any]], excluded: list[str]) -> dict[str, Any]:
    available = sum(part["weight"] for part in parts)
    earned = round(sum(part["earned"] for part in parts), 2)
    return {
        "components": parts,
        "earned": earned,
        "available": available,
        "excluded": excluded,
        "score": round(100.0 * earned / available, 2) if available else 0.0,
    }


def outcome_of(gates: dict[str, Any]) -> str:
    statuses = gates.get("milestones", {}).get("statuses") or {}
    for name in sorted(statuses):
        status = statuses[name]
        if status != "done":
            return (
                status if status.startswith("fail@") else f"fail@{name.split('-')[0]}"
            )
    return "pass"


# --- report -----------------------------------------------------------------


def table(headers: list[str], rows: list[list[str]]) -> str:
    lines = ["| " + " | ".join(headers) + " |"]
    lines.append("| " + " | ".join("---" for _ in headers) + " |")
    lines += ["| " + " | ".join(row) + " |" for row in rows]
    return "\n".join(lines)


def compact(count: int) -> str:
    if count >= 1_000_000:
        return f"{count / 1_000_000:.1f}M"
    if count >= 1_000:
        return f"{count / 1_000:.1f}k"
    return str(count)


def layer(args: argparse.Namespace, name: str, compute) -> dict[str, Any]:
    supplied = getattr(args, f"{name}_json")
    if supplied:
        log(f"report: {name} taken from {supplied}")
        return json.loads(Path(supplied).read_text())
    return compute()


def render_detail(
    entry: dict[str, Any],
    args: argparse.Namespace,
    row: dict[str, str],
    gates: dict[str, Any],
    corpus: dict[str, Any],
    mutations: dict[str, Any],
    profile: dict[str, Any],
    cost: dict[str, Any],
    code: dict[str, Any],
    agentic: dict[str, Any],
) -> str:
    run = profile["run"]
    aggregate = corpus["aggregate"]
    front = {
        "benchmark": entry["id"],
        "model": run["model"],
        "branch": args.branch,
        "run_id": run["run_id"],
        "date": run["date"],
        "outcome": row["outcome"],
        "code": code["score"],
        "agentic": agentic["score"],
        "review": None,
        "status": "measuring",
    }
    blocks = [
        "---\n" + yaml.safe_dump(front, sort_keys=False).strip() + "\n---",
        f"# Benchmark run — {run['model']}",
        f"Branch `{args.branch}` scored against the `{entry['id']}` registry entry, baseline `{entry['baseline']}`. Every number below is computed by `bench-score`; the history row in [history.md](../history.md) is this file's summary.",
        "## Summary",
        table(
            ["field", "value"],
            [[key, row[key]] for key in entry["history_columns"] if key != "run"],
        ),
        "## Gates",
        table(
            ["check", "verdict", "evidence"],
            [
                [
                    name,
                    "pass" if gates[name]["pass"] else "**fail**",
                    gates[name]["evidence"],
                ]
                for name in sorted(gates)
            ],
        ),
        "## Corpus quality",
        table(
            ["metric", "value", "evidence"],
            [
                ["cases", str(aggregate["case_count"]), f"`{entry['cases_dir']}`"],
                [
                    "etalon recall",
                    f"{aggregate['recall']['matched']}/{aggregate['recall']['total']} ({aggregate['recall']['pct']}%)",
                    "exact case-name matches against the frozen etalon list",
                ],
                [
                    "gap cases",
                    f"{aggregate['gaps']['matched']}/{aggregate['gaps']['total']}",
                    "cases with no unit-test counterpart",
                ],
                [
                    "four-channel cases",
                    f"{aggregate['four_channel_cases']}/{aggregate['case_count']} ({aggregate['four_channel_pct']}%)",
                    "exit + stdout + stderr + expected all asserted",
                ],
                [
                    "wildcard line ratio",
                    str(aggregate["wildcard_line_ratio"]),
                    f"{aggregate['wildcard_lines']} wildcarded of {aggregate['asserted_lines']} asserted lines",
                ],
            ],
        ),
        "## Mutation kills",
        f"The frozen set at `{entry['mutations_dir']}` applied one patch at a time over the branch's corpus via `{mutations['command']}`: **{mutations['kill_rate']} killed** ({mutations['kill_rate_pct']}%)"
        + (
            f", {mutations['not_applicable']} not applicable and out of the denominator"
            if mutations["not_applicable"]
            else ""
        )
        + ".",
        table(
            ["patch", "verdict", "evidence"],
            [
                [
                    f"`{result['patch']}`",
                    "killed" if result["verdict"] == "killed" else f"**{result['verdict']}**",
                    result["evidence"],
                ]
                for result in mutations["patches"]
            ],
        ),
        "## Process profile",
        table(
            [
                "milestone",
                "attempts",
                "feedback files",
                "wall",
                "tool calls",
                "malformed",
                "loops",
                "deaths",
                "blind rebaselines",
                "pushed lines",
            ],
            [
                [
                    name,
                    str(entry_["attempts"]),
                    str(entry_["feedback_files"]),
                    human_ms(entry_["wall_ms"]),
                    str(entry_["tool_calls"]),
                    str(entry_["malformed"]),
                    str(entry_["loops"]),
                    str(entry_["deaths"]),
                    str(entry_["blind_rebaselines"]),
                    str(entry_["pushed_lines"]),
                ]
                for name, entry_ in sorted(profile["milestones"].items())
            ],
        ),
        f"Tool mix: {', '.join(f'{name} {count}' for name, count in profile['totals']['tools'].items())}. Worker wall clock {run['wall']} across {run['attempts_total']} attempt log(s); first log start to last log end spans {run['span']}.",
        "## Cost",
        table(
            [
                "milestone",
                "generations",
                "cost USD",
                "native prompt",
                "native completion",
                "of which cached",
            ],
            [
                [
                    name,
                    str(int(bucket["ids"])),
                    f"{bucket['cost']:.4f}",
                    compact(int(bucket["prompt"])),
                    compact(int(bucket["completion"])),
                    compact(int(bucket["cached"])),
                ]
                for name, bucket in sorted(cost["milestones"].items())
            ],
        ),
        f"Source `{cost['source']}` via `{cost['endpoint']}`: {cost['fetched']}/{cost['unique_ids']} unique generation ids fetched from {cost['id_mentions']} id mentions, failures {cost['failures'] or 'none'}. OpenRouter total ${cost['openrouter_cost_usd']:.4f}; the ndjson fallback figure — {cost['fallback_label'] or "Claude Code's own pricing, not OpenRouter billing"} — is ${cost['fallback_cost_usd']:.4f}.",
        "## Composites",
        f"`code` scores {code['earned']} of {code['available']} available weight"
        + (
            f", with {', '.join(code['excluded'])} not measured and dropped from the denominator"
            if code["excluded"]
            else ""
        )
        + f" → **{code['score']}/100**.",
        table(
            ["component", "weight", "earned", "arithmetic"],
            [
                [p["id"], str(p["weight"]), str(p["earned"]), p["arithmetic"]]
                for p in code["components"]
            ],
        ),
        f"`agentic` scores {agentic['earned']} of {agentic['available']} available weight"
        + (
            f", with {', '.join(agentic['excluded'])} not measured and dropped from the denominator"
            if agentic["excluded"]
            else ""
        )
        + f" → **{agentic['score']}/100**.",
        table(
            ["component", "weight", "earned", "arithmetic"],
            [
                [p["id"], str(p["weight"]), str(p["earned"]), p["arithmetic"]]
                for p in agentic["components"]
            ],
        ),
        "## Review",
        "Placeholder — the `model-benchmark` playbook's measure step replaces this section with one row per diff reviewer and its findings, and writes the mean grade into the `review` column of the history row.",
        table(
            ["reviewer", "grade /5", "findings"],
            [["_pending_", "_pending_", "_pending_"]],
        ),
        "## History row",
        table(
            entry["history_columns"], [[row[key] for key in entry["history_columns"]]]
        ),
    ]
    return "\n\n".join(blocks) + "\n"


def cmd_report(entry: dict[str, Any], args: argparse.Namespace) -> str:
    gates = layer(args, "gates", lambda: cmd_gates(entry, args.branch))
    corpus = layer(args, "corpus", lambda: cmd_corpus(entry, args.branch))
    mutations = layer(args, "mutations", lambda: cmd_mutations(entry, args.branch))
    profile = layer(args, "process", lambda: cmd_process(entry, args))
    cost = layer(args, "cost", lambda: cmd_cost(entry, args))

    outcome = outcome_of(gates)
    code = score_code(entry, gates, corpus, mutations)
    agentic = score_agentic(entry, profile, outcome)
    run = profile["run"]
    slug = model_slug_from_branch(entry, args.branch)
    detail = f"{run['run_id']}-{slug}.md"
    tokens = cost["tokens"]["prompt"] + cost["tokens"]["completion"]

    row = {
        "date": run["date"],
        "model": f"`{run['model']}`",
        "outcome": outcome,
        "att": run["attempts_per_milestone"],
        "code": f"{code['score']:.1f}",
        "agentic": f"{agentic['score']:.1f}",
        "review": "_pending_",
        "diff": str(profile["totals"]["churn"]["diff_lines"]),
        "tokens": compact(tokens),
        "cost": f"${cost['total_cost_usd']:.2f}",
        "wall": run["wall"],
        "run": f"[{run['run_id']}](runs/{detail})",
    }
    body = render_detail(
        entry, args, row, gates, corpus, mutations, profile, cost, code, agentic
    )
    line = "| " + " | ".join(row[key] for key in entry["history_columns"]) + " |"

    target = args.registry.parent / entry["runs_dir"] / detail
    if args.dry_run:
        log(f"report: --dry-run, would write {target}")
        return f"{line}\n\n{body}"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(body)
    log(f"report: wrote {target}")
    return line


# --- entry point ------------------------------------------------------------


def main() -> None:
    parser = argparse.ArgumentParser(prog="bench-score")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    def add(name: str, branch_required: bool = True) -> argparse.ArgumentParser:
        sub = subparsers.add_parser(name)
        sub.add_argument("--benchmark", required=True)
        sub.add_argument("--branch", required=branch_required)
        sub.add_argument("--registry", default=DEFAULT_REGISTRY, type=Path)
        return sub

    add("gates")
    add("corpus")
    add("mutations")
    for name in ("process", "cost", "report"):
        sub = add(name, branch_required=name == "report")
        sub.add_argument("--ndjson", action="append", default=[])
        sub.add_argument("--since")
        sub.add_argument("--until")
        if name != "process":
            sub.add_argument("--process-json")
            sub.add_argument("--endpoint")

    report = subparsers.choices["report"]
    for name in ("gates", "corpus", "cost", "mutations"):
        report.add_argument(f"--{name}-json")
    report.add_argument("--dry-run", action="store_true")

    args = parser.parse_args()
    supplied = args.subcommand == "cost" and args.process_json
    if args.subcommand in ("process", "cost") and not (
        args.branch or args.ndjson or supplied
    ):
        parser.error(f"{args.subcommand}: one of --branch or --ndjson is required")
    entry = load_entry(args.registry, args.benchmark)

    if args.subcommand == "report":
        sys.stdout.write(cmd_report(entry, args) + "\n")
        return
    if args.subcommand == "gates":
        payload = cmd_gates(entry, args.branch)
    elif args.subcommand == "corpus":
        payload = cmd_corpus(entry, args.branch)
    elif args.subcommand == "mutations":
        payload = cmd_mutations(entry, args.branch)
    elif args.subcommand == "process":
        payload = cmd_process(entry, args)
    else:
        payload = cmd_cost(entry, args)
    json.dump(payload, sys.stdout, indent=2)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
