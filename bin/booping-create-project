#!/usr/bin/env bash
# Scaffold a new booping project.
# Installed on PATH automatically when the booping plugin is enabled.
#
# Default mode: scaffold the vault at <home_dir>/{project-name} and write a
#   '.booping' marker (project_name:, latest_migration:) in the cwd to attach.
#   A fresh vault needs no migration, so it is seeded at the highest shipped id.
#   The vault-home base
#   (<home_dir>) is resolved via a ladder: `booping config-get home_dir` →
#   $HOME/Claude if it exists → interactive prompt (seeds the global config).
# Local mode (--local [dir]): scaffold the vault inside the repo at the given
#   repo-relative dir (default ./booping) and write a marker carrying both
#   project_name: and vault_path:.
#
# Usage:
#   booping-create-project <project-name> [cwd-to-attach]
#   booping-create-project <project-name> --local [dir]

set -euo pipefail

# Resolve the sibling booping binary via this script's own location — never PATH,
# so a shadowing binary elsewhere on PATH can't be picked up.
BOOPING="$(dirname "$0")/booping"

usage() {
    cat <<'EOF'
Usage:
  booping-create-project <project-name> [cwd-to-attach]
  booping-create-project <project-name> --local [dir]

Default mode scaffolds the vault at <home_dir>/<project-name> and writes a
'.booping' marker (project_name:) in the cwd to attach. <home_dir> is resolved
via `booping config-get home_dir`, falling back to $HOME/Claude, then to an
interactive prompt that seeds the global config.

--local [dir]  Scaffold the vault inside the repo at <dir> (repo-relative,
               default ./booping) and write a marker carrying both
               project_name: and vault_path:.
EOF
}

# Expand a leading `~` / `~/` in a path against $HOME.
expand_tilde() {
    case "$1" in
        "~") printf '%s' "$HOME" ;;
        "~/"*) printf '%s' "$HOME/${1#\~/}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# Resolve the vault-home base directory for default mode (see ladder above).
# Prints the expanded absolute base dir on stdout.
#
# "config present" means a user-authored global config file exists — the core
# config always carries a `home_dir` default, so `config-get` alone can't
# distinguish a configured value from that fallback. When the global file is
# present we trust its merged value; otherwise we fall through to $HOME/Claude
# or an interactive prompt that seeds the global file.
resolve_home_dir() {
    local cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/booping"
    local cfg_file="$cfg_dir/config.yaml"

    local home_dir
    if [ -f "$cfg_file" ] \
        && home_dir="$("$BOOPING" config-get home_dir 2>/dev/null)" \
        && [ -n "$home_dir" ]; then
        expand_tilde "$home_dir"
        return 0
    fi

    if [ -d "$HOME/Claude" ]; then
        printf '%s' "$HOME/Claude"
        return 0
    fi

    if [ ! -t 0 ]; then
        cat >&2 <<EOF
error: cannot determine the vault-home directory.

No 'home_dir' is configured and $HOME/Claude does not exist, and stdin is not a
terminal so I can't prompt. Set 'home_dir' in the global config, e.g.:

  mkdir -p "$cfg_dir"
  printf 'home_dir: ~/Claude/\n' > "$cfg_file"

then re-run this command.
EOF
        return 1
    fi

    local answer
    printf 'Vault home dir [~/Claude]: ' >&2
    read -r answer
    [ -z "$answer" ] && answer="~/Claude"

    if [ -e "$cfg_file" ]; then
        echo "error: refusing to overwrite existing global config: $cfg_file" >&2
        return 1
    fi
    mkdir -p "$cfg_dir"
    printf 'home_dir: %s\n' "$answer" > "$cfg_file"
    echo "Seeded global config: $cfg_file (home_dir: $answer)" >&2

    expand_tilde "$answer"
}

if [ $# -ge 1 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; }; then
    usage
    exit 0
fi

LOCAL_MODE=0
LOCAL_DIR="./booping"
POSITIONAL=()

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --local)
            LOCAL_MODE=1
            if [ $# -ge 2 ] && [[ "$2" != -* ]]; then
                LOCAL_DIR="$2"
                shift 2
            else
                shift
            fi
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done

set -- "${POSITIONAL[@]}"

if [ $# -lt 1 ]; then
    usage >&2
    exit 1
fi

PROJECT="$1"
ATTACH_CWD="${2:-$(pwd)}"

if [ "$LOCAL_MODE" -eq 1 ]; then
    ROOT="$LOCAL_DIR"

    if [ -e "$ROOT" ]; then
        echo "Local vault already exists: $ROOT" >&2
        exit 1
    fi

    mkdir -p "$ROOT"/{plans,retrospectives,lessons,_booping,notes}

    printf '_booping/*.log\n' > "$ROOT/.gitignore"

    if [ -d "$ATTACH_CWD" ] && [ ! -f "$ATTACH_CWD/.booping" ]; then
        {
            echo "project_name: $PROJECT"
            echo "vault_path: $LOCAL_DIR"
        } > "$ATTACH_CWD/.booping"
        (cd "$ATTACH_CWD" && "$BOOPING" marker-set latest_migration=@latest)
        echo "Wrote marker: $ATTACH_CWD/.booping"
    fi

    echo "Initialized local vault: $ROOT"
    echo "Run booping-create-project --help for usage."
    exit 0
fi

# If the second arg is an absolute path, use it directly as the project root
# (useful for smoketests and non-standard locations). Otherwise default to ~/Claude/$PROJECT.
IS_ABSOLUTE_ROOT=0
if [[ "${2:-}" == /* ]]; then
    ROOT="$2"
    IS_ABSOLUTE_ROOT=1
else
    if ! HOME_DIR="$(resolve_home_dir)"; then
        exit 1
    fi
    ROOT="${HOME_DIR%/}/$PROJECT"
fi

if [ -d "$ROOT" ]; then
    echo "Project already exists: $ROOT" >&2
    exit 1
fi

mkdir -p "$ROOT"/{plans,retrospectives,lessons,_booping,notes}

# Smoketest / absolute-path invocations don't write a marker —
# they are transient and should leave no global state.
# Normal invocations write a '.booping' marker in cwd so resolve_project can find the vault.
if [ "$IS_ABSOLUTE_ROOT" -eq 0 ]; then
    if [ -d "$ATTACH_CWD" ] && [ ! -f "$ATTACH_CWD/.booping" ]; then
        echo "project_name: $PROJECT" > "$ATTACH_CWD/.booping"
        (cd "$ATTACH_CWD" && "$BOOPING" marker-set latest_migration=@latest)
        echo "Wrote marker: $ATTACH_CWD/.booping"
    fi
fi

echo "Initialized: $ROOT"
echo "Run booping-create-project --help for usage."
