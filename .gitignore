.coverage
__pycache__/
*.pyc
.DS_Store
.booping
.debug_enabled
site/

# Fixture vaults need their own .booping / .debug_enabled markers tracked in git.
!booping-python/tests/__fixtures__/**/.booping
!booping-python/tests/__fixtures__/**/.debug_enabled
!playbooks/_fixtures/vault/.booping

# Debug playbook renders (just snapshots-render) — machine-specific, never committed
playbooks/*/_reports/local.md

# Per-run benchmark workspaces — throwaway clones the model-benchmark playbook develops in.
.benchmarks/

# Vault scratchpad — local working notes, not part of the published vault.
vault/notes/
.booping.log
