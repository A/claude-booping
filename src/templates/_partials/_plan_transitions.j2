{#-
  Renders a per-skill slice of the plan lifecycle.

  Edge resolution mirrors booping.context.lifecycle.resolve_edges: a status's
  own transitions, unioned with its superstate's inherited transitions, with
  substate edges winning on `to` collision. Inherited (non-own) edges are
  tagged `*(via <superstate>)*`.

  The `On exit (auto)` column is derived from the resolved hook list
  (boundary on_exit + edge hooks + boundary on_entry, mirroring resolve_hooks)
  — never hand-written. `frontmatter-update` hooks render as "sets `k`, …"
  (the implicit `status=` set and the automatic post hook are suppressed).
-#}
{%- set superstates = config.plan.get("superstates", {}) -%}
{%- macro superstate_of(status) -%}
{%- for name, ss in superstates.items() if status in ss.get("states", []) %}{{ name }}{% endfor -%}
{%- endmacro -%}
{#- Summarise the resolved hook list for one edge as short prose. -#}
{%- macro hook_summary(from_status, edge) -%}
{%- set from_ss = superstate_of(from_status) | trim -%}
{%- set to_ss = superstate_of(edge.to) | trim -%}
{%- set ns = namespace(hooks=[]) -%}
{%- if from_ss and from_ss != to_ss %}{% set ns.hooks = ns.hooks + (superstates[from_ss].get("on_exit") or []) %}{% endif -%}
{%- set ns.hooks = ns.hooks + (edge.get("hooks") or []) -%}
{%- if to_ss and from_ss != to_ss %}{% set ns.hooks = ns.hooks + (superstates[to_ss].get("on_entry") or []) %}{% endif -%}
{%- set ns2 = namespace(fields=[], parts=[]) -%}
{%- for hook in ns.hooks -%}
{%- set tokens = hook.split() -%}
{%- if tokens[0] == "frontmatter-update" -%}
{%- for pair in tokens[1:] -%}
{%- set fkey = pair.split("=")[0] -%}
{%- if fkey != "status" and fkey not in ns2.fields %}{% set ns2.fields = ns2.fields + [fkey] %}{% endif -%}
{%- endfor -%}
{%- elif tokens[0] == "vault-commit" -%}
{#- automatic post hook — implicit, not shown -#}
{%- else %}{% set ns2.parts = ns2.parts + [hook | trim] %}{% endif -%}
{%- endfor -%}
{%- if ns2.fields %}{{ "sets `" + (ns2.fields | join("`, `")) + "`" }}{% if ns2.parts %}; {% endif %}{% endif -%}
{%- if ns2.parts %}{{ ns2.parts | join("; ") }}{% endif -%}
{%- if not ns2.fields and not ns2.parts %}—{% endif -%}
{%- endmacro -%}
{% macro render(skill) -%}
## Plan Transitions

This table is the contract: the valid moves and their requirements — `Gates` (must hold before the move) and `On exit (auto)` (the mechanical mutations the move applies). When an internal action matches a `When` trigger, verify every `Gate` holds, then execute the move with one command — it applies every mechanical mutation (status, date stamps, commit snapshot, vault commit) deterministically:

```bash
booping transition <to-status> plans/<plan-file>.md [--also <artifact>...]
```

Pass every vault artifact the skill authored for this move (e.g. a retrospective file, a sibling stub plan) via `--also` so it lands in the same transition commit. Do not hand-edit `status:` or hand-run `git commit` — the command owns all of it. It prints a report of every mutation it applied (`<from> → <to>`, then one line per hook); the report is authoritative — do not re-read the plan to verify.

{% for key, s in config.plan.statuses.items() -%}
{%- set from_ss = superstate_of(key) | trim -%}
{%- set own = s.get("transitions") or [] -%}
{%- set own_tos = own | map(attribute="to") | list -%}
{%- set edges = namespace(rows=[]) -%}
{%- for t in own if t.skill == skill %}{% set edges.rows = edges.rows + [{"edge": t, "via": ""}] %}{% endfor -%}
{%- if from_ss -%}
{%- for t in (superstates[from_ss].get("transitions") or []) if t.skill == skill and t.to not in own_tos %}{% set edges.rows = edges.rows + [{"edge": t, "via": from_ss}] %}{% endfor -%}
{%- endif -%}
{%- if s.get("owner") == skill or edges.rows -%}
### `{{ key }}` — {{ s.desc }}

{% if s.get("artifacts") -%}
**Artifacts**
{% for a in s.artifacts -%}
- {{ a }}
{% endfor %}

{% endif -%}

{% if edges.rows -%}
| To | When | Gates | On exit (auto) |
|----|------|-------|----------------|
{% for r in edges.rows -%}
| `{{ r.edge.to }}`{% if r.via %} *(via {{ r.via }})*{% endif %} | {{ r.edge.when }} | {% set gs = r.edge.get("gates") %}{% if gs %}{% for g in gs %}{{ g }}{% if not loop.last %}; {% endif %}{% endfor %}{% else %}—{% endif %} | {{ hook_summary(key, r.edge) }} |
{% endfor %}

{% else -%}
_`/{{ skill }}` owns this state; iterate in place until the user signals a move._

{% endif -%}
{% endif -%}
{%- endfor -%}
{%- endmacro %}
