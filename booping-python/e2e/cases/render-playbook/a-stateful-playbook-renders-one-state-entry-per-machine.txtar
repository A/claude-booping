-- fixtures/home/Claude/_playbooks/fx-stateful/playbook.yaml --
state: main
graph:
  intake: []
  step-pipeline:
    dependencies: [intake]
    state: step
    repeat: once per item the intake names
    graph:
      spec: []
      review: [spec]

states:
  step:
    artifact: steps/{instance}/index.md
    initial: spec-ing
    statuses:
      spec-ing:
        transitions:
          - to: reviewing
            when: spec written
      reviewing:
        transitions:
          - to: done
            when: user confirmed the spec
            gates: ["explicit user confirmation captured"]
      done: {terminal: true}
  main:
    artifact: index.md
    initial: intaking
    statuses:
      intaking:
        transitions:
          - to: developing-steps
            when: intake step complete
            gates: ["request + scope captured in the artifact"]
            hooks:
              - frontmatter-update intaken=yes
      developing-steps:
        transitions:
          - to: done
            when: every step instance terminal
      done: {terminal: true}
