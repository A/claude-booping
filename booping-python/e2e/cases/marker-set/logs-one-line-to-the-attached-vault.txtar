The run appends exactly one [marker-set] line to the attached vault's log, naming the marker
it rewrote and the pair it wrote there.

-- fixtures/cwd/.booping --
# booping project marker
project_name: "demo"  # quoted on purpose
vault_path: ./vault
-- cmd --
booping marker-set latest_migration=3
-- exit --
0
-- stdout --
-- stderr --
marker: latest_migration=3
-- expected/cwd/vault/.booping.log --
[..]Z: [marker-set] {CWD}/.booping latest_migration=3
