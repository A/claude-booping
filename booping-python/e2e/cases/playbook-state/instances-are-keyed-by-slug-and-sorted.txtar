-- cmd --
booping playbook-transition fx-steps spec-ing --state step --instance zulu --workdir run
booping playbook-transition fx-steps spec-ing --state step --instance alpha --workdir run
booping playbook-transition fx-steps spec-ing --state step --instance mike --workdir run
booping playbook-transition fx-steps done --state step --instance mike --workdir run
booping playbook-state fx-steps --workdir run
