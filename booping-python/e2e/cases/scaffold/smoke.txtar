Scaffolds a one-file tree declared in the global config tier, seeding it with a --set value.

-- fixtures/xdg/booping/config.yaml --
core:
  e2e_smoke:
    tree:
      README.md: "hello {{ name }}\n"
-- cmd --
booping scaffold core.e2e_smoke.tree out --set name=world
-- exit --
0
-- stdout --
created dir out
--- /dev/null
+++ out/README.md
@@ -0,0 +1 @@
+hello world
scaffolded 2 paths — 1 dirs created, 1 files created, 0 files overwritten
-- expected/cwd/out/README.md --
hello world
