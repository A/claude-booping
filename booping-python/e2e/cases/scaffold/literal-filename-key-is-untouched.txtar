A key with no template syntax is used verbatim, whatever --set pairs the run carries.

-- fixtures/xdg/booping/config.yaml --
core:
  e2e_demo:
    tree:
      "index.md": "body\n"
-- cmd --
booping scaffold core.e2e_demo.tree out --set slug=unused
-- exit --
0
-- stdout --
created dir out
--- /dev/null
+++ out/index.md
@@ -0,0 +1 @@
+body
scaffolded 2 paths — 1 dirs created, 1 files created, 0 files overwritten
-- expected/cwd/out/index.md --
body
