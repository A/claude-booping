A `--direction` outside the item vocabulary is a user error naming the allowed values.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/config.yaml --
macro_stubs:
  core.macros.date: "2026-10-15"
-- cmd --
booping items add --title "Gap" --direction sideways
-- exit --
1
-- stdout --
-- stderr --
error: --direction `sideways` is not one of: code-to-spec, spec-to-code, conflict, clarify
