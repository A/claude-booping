A stubbed macro value is resolved (not executed) from `macro_stubs` and lands typed
in the frontmatter; here the stub `42` is coerced to an integer.

-- fixtures/xdg/booping/config.yaml --
macro_stubs:
  core.macros.count: "42"
-- fixtures/cwd/plan.md --
---
title: Foo
---
# Body
-- cmd --
booping frontmatter-update plan.md 'count={{ macro("core.macros.count") }}'
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,4 +1,5 @@
 ---
 title: Foo
+count: 42
 ---
 # Body
-- stderr --
updated plan.md: count=42
-- expected/cwd/plan.md --
---
title: Foo
count: 42
---
# Body
