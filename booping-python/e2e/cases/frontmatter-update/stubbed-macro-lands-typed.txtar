A stubbed macro value is interpolated and lands as the YAML type of that literal.

-- fixtures/xdg/booping/config.yaml --
macro_stubs:
  core.macros.echo: "1"
-- fixtures/cwd/plan.md --
---
title: Foo
---
# Body
-- cmd --
booping frontmatter-update plan.md "sp={{ macro('core.macros.echo') }}"
-- expected/cwd/plan.md --
---
title: Foo
sp: 1
---
# Body
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,4 +1,5 @@
 ---
 title: Foo
+sp: 1
 ---
 # Body
-- stderr --
updated plan.md: sp=1
