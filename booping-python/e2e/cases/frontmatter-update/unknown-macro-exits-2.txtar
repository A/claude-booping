A macro path that is neither stubbed nor declared exits 2 with a stderr message
naming the missing path.

-- fixtures/xdg/booping/config.yaml --
macro_stubs:
  core.macros.present: "1"
-- fixtures/cwd/plan.md --
---
title: Foo
---
# Body
-- cmd --
booping frontmatter-update plan.md 'key={{ macro("core.macros.nope") }}'
-- exit --
2
-- stdout --
-- stderr --
error: value '{{ macro("core.macros.nope") }}': no macro declared at config path: core.macros.nope
