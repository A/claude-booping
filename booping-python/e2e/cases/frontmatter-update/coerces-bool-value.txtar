A boolean string value is coerced to a bool and written unquoted in the frontmatter.

-- fixtures/cwd/plan.md --
---
title: My Plan
---
# My Plan
-- cmd --
booping frontmatter-update plan.md done=true
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,4 +1,5 @@
 ---
 title: My Plan
+done: true
 ---
 # My Plan
-- stderr --
updated plan.md: done=true
-- expected/cwd/plan.md --
---
title: My Plan
done: true
---
# My Plan
