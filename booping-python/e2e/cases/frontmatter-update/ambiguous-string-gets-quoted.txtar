A string that plain YAML would reload as a mapping is single-quoted so it
reloads as the string it was written as.

-- fixtures/cwd/plan.md --
---
title: Foo
---
# Body
-- cmd --
booping frontmatter-update plan.md 'summary=a: b'
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,4 +1,5 @@
 ---
 title: Foo
+summary: 'a: b'
 ---
 # Body
-- stderr --
updated plan.md: summary=a: b
-- expected/cwd/plan.md --
---
title: Foo
summary: 'a: b'
---
# Body
