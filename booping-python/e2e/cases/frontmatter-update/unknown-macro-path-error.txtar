Referencing a macro path that has no declaration exits 2 with a descriptive error on stderr
containing the path.

-- fixtures/xdg/booping/config.yaml --
core:
  macros:
    other: ["echo", "other"]
-- fixtures/cwd/plan.md --
---
title: Foo
---
# Body
-- cmd --
booping frontmatter-update plan.md 'value={{ macro("core.macros.nonexistent") }}'
-- exit --
2
-- stdout --
-- stderr --
error: value '{{ macro("core.macros.nonexistent") }}': no macro declared at config path: core.macros.nonexistent
