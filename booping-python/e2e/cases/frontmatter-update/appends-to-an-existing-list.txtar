--append extends an existing list with the new value.

-- fixtures/cwd/plan.md --
---
title: Foo
sessions:
  - abc-123
---
# Body
-- cmd --
booping frontmatter-update plan.md --append sessions=def-456
-- expected/cwd/plan.md --
---
title: Foo
sessions:
- abc-123
- def-456
---
# Body
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,6 +1,7 @@
 ---
 title: Foo
 sessions:
-  - abc-123
+- abc-123
+- def-456
 ---
 # Body
-- stderr --
updated plan.md: sessions+=def-456
