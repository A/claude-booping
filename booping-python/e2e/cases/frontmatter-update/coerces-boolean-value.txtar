Boolean-formatted values are coerced and emitted as plain boolean literals in YAML.

-- fixtures/cwd/plan.md --
---
title: Demo
blocked: false
---
# Demo
-- cmd --
booping frontmatter-update plan.md blocked=true
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,5 +1,5 @@
 ---
 title: Demo
-blocked: false
+blocked: true
 ---
 # Demo
-- stderr --
updated plan.md: blocked=true
-- expected/cwd/plan.md --
---
title: Demo
blocked: true
---
# Demo
