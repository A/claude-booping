--append onto an existing scalar exits 1 and names the key.

-- fixtures/cwd/plan.md --
---
title: Foo
status: backlog
---
# Body
-- cmd --
booping frontmatter-update plan.md --append status=done
-- expected/cwd/plan.md --
---
title: Foo
status: backlog
---
# Body
-- exit --
1
-- stdout --
-- stderr --
error: cannot append to scalar key 'status' in plan.md
