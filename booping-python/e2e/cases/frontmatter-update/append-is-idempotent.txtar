Appending an identical value twice is idempotent and the second call prints no diff.

-- fixtures/cwd/plan.md --
---
title: Demo
sessions: null
---
# Demo
-- cmd --
booping frontmatter-update plan.md --append sessions=abc-123
booping frontmatter-update plan.md --append sessions=abc-123
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,5 +1,6 @@
 ---
 title: Demo
-sessions: null
+sessions:
+- abc-123
 ---
 # Demo
-- stderr --
updated plan.md: sessions+=abc-123
updated plan.md: sessions+=abc-123
-- expected/cwd/plan.md --
---
title: Demo
sessions:
- abc-123
---
# Demo
