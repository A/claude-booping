Appending to an existing list adds the new value without duplicating.

-- fixtures/cwd/plan.md --
---
title: Foo
sessions:
- abc-123
---
# Plan
-- cmd --
booping frontmatter-update plan.md --append sessions=def-456
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -2,5 +2,6 @@
 title: Foo
 sessions:
 - abc-123
+- def-456
 ---
 # Plan
-- stderr --
updated plan.md: sessions+=def-456
-- expected/cwd/plan.md --
---
title: Foo
sessions:
- abc-123
- def-456
---
# Plan
