An integer-looking value lands in the frontmatter as a plain YAML integer, not a quoted string.

-- fixtures/cwd/plan.md --
---
title: Foo
---
# Body
-- cmd --
booping frontmatter-update plan.md sp=23
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,4 +1,5 @@
 ---
 title: Foo
+sp: 23
 ---
 # Body
-- expected/cwd/plan.md --
---
title: Foo
sp: 23
---
# Body
