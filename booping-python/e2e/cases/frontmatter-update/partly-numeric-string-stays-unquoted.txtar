A partly-numeric string is written as a plain YAML string, not an integer.

-- fixtures/cwd/plan.md --
---
title: Foo
---
# Body
-- cmd --
booping frontmatter-update plan.md "summary=23 things"
-- expected/cwd/plan.md --
---
title: Foo
summary: 23 things
---
# Body
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,4 +1,5 @@
 ---
 title: Foo
+summary: 23 things
 ---
 # Body
-- stderr --
updated plan.md: summary=23 things
