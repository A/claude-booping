A --append onto a key the frontmatter does not carry adds it as a one-element list.

-- fixtures/cwd/plan.md --
---
title: Foo
status: backlog
---
# My Plan

- [ ] 3 SP: Task one
- [ ] 2 SP: Task two
-- cmd --
booping frontmatter-update plan.md --append sessions=abc-123
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,6 +1,8 @@
 ---
 title: Foo
 status: backlog
+sessions:
+- abc-123
 ---
 # My Plan
 
-- stderr --
updated plan.md: sessions+=abc-123
-- expected/cwd/plan.md --
---
title: Foo
status: backlog
sessions:
- abc-123
---
# My Plan

- [ ] 3 SP: Task one
- [ ] 2 SP: Task two
