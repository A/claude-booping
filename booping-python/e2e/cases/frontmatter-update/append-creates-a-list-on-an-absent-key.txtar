A key the block never carried is created by --append as a one-element sequence at the end
of the block.

-- fixtures/cwd/plan.md --
---
title: Foo
---
# Body
-- cmd --
booping frontmatter-update plan.md --append sessions=abc-123
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,4 +1,6 @@
 ---
 title: Foo
+sessions:
+- abc-123
 ---
 # Body
-- stderr --
updated plan.md: sessions+=abc-123
-- expected/cwd/plan.md --
---
title: Foo
sessions:
- abc-123
---
# Body
