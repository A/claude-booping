A float-looking value lands in the frontmatter as a plain YAML float, not a quoted string.

-- fixtures/cwd/plan.md --
---
title: Foo
---
# Body
-- cmd --
booping frontmatter-update plan.md ratio=1.5
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,4 +1,5 @@
 ---
 title: Foo
+ratio: 1.5
 ---
 # Body
-- expected/cwd/plan.md --
---
title: Foo
ratio: 1.5
---
# Body
