Appending to a key that does not exist creates a one-element list.

-- fixtures/cwd/plan.md --
---
title: Test Plan
---
# Body

-- cmd --
booping frontmatter-update plan.md --append tags=first
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,5 +1,7 @@
 ---
 title: Test Plan
+tags:
+- first
 ---
 # Body
 
-- stderr --
updated plan.md: tags+=first
-- expected/cwd/plan.md --
---
title: Test Plan
tags:
- first
---
# Body

