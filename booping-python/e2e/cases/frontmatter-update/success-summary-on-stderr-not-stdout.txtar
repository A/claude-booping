The success summary line goes to stderr, not stdout.

-- fixtures/cwd/plan.md --
---
title: My Plan
---
# My Plan
-- cmd --
booping frontmatter-update plan.md status=pending
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,4 +1,5 @@
 ---
 title: My Plan
+status: pending
 ---
 # My Plan
-- stderr --
updated plan.md: status=pending
-- expected/cwd/plan.md --
---
title: My Plan
status: pending
---
# My Plan
