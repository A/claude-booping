A macro call referencing an unknown config path exits 2 with a stderr message naming the path.

-- fixtures/xdg/booping/config.yaml --
macro_stubs:
  core.macros.known: ok
-- fixtures/cwd/plan.md --
---
title: Test Plan
---
# Body

-- cmd --
booping frontmatter-update plan.md 'value={{ macro("core.macros.unknown") }}'
-- exit --
2
-- stdout --
-- stderr --
error: value '{{ macro("core.macros.unknown") }}': no macro declared at config path: core.macros.unknown
