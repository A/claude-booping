A macro-rendered date-like value remains a YAML string (not coerced to a timestamp or
other type).

-- fixtures/xdg/booping/config.yaml --
core:
  macros:
    mydate: ["date"]
macro_stubs:
  core.macros.mydate: "2026-01-15 10:30"
-- fixtures/cwd/plan.md --
---
title: Foo
---
# Body
-- cmd --
booping frontmatter-update plan.md 'completed={{ macro("core.macros.mydate") }}'
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,4 +1,5 @@
 ---
 title: Foo
+completed: 2026-01-15 10:30
 ---
 # Body
-- stderr --
updated plan.md: completed=2026-01-15 10:30
-- expected/cwd/plan.md --
---
title: Foo
completed: 2026-01-15 10:30
---
# Body
