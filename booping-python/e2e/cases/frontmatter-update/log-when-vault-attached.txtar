.booping.log gains one [..]-wildcarded line when a vault is attached.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
-- fixtures/cwd/vault/config.yaml --
core:
  e2e_demo:
    tree:
      README.md: "hello world\n"
-- fixtures/cwd/plan.md --
---
title: Test Plan
status: backlog
---

# Test Plan Content

This is a test plan.
-- cmd --
booping frontmatter-update plan.md status="in-progress"
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,6 +1,6 @@
 ---
 title: Test Plan
-status: backlog
+status: in-progress
 ---
 
 # Test Plan Content
-- expected/cwd/vault/.booping.log --
[..]Z: [frontmatter-update] plan.md status
-- stderr --
updated plan.md: status=in-progress
