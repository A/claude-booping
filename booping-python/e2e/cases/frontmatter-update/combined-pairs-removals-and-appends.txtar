Updates pairs, removes keys, and appends to lists in a single frontmatter-update call.

-- fixtures/cwd/plan.md --
---
title: Demo
status: backlog
stale: x
sessions: null
---
# Demo
-- cmd --
booping frontmatter-update plan.md status=in-progress --remove stale --append sessions=abc-123
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,7 +1,7 @@
 ---
 title: Demo
-status: backlog
-stale: x
-sessions: null
+status: in-progress
+sessions:
+- abc-123
 ---
 # Demo
-- stderr --
updated plan.md: -stale, status=in-progress, sessions+=abc-123
-- expected/cwd/plan.md --
---
title: Demo
status: in-progress
sessions:
- abc-123
---
# Demo
