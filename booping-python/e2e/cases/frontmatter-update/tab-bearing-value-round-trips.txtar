A value bearing a tab round-trips through coercion: the file stores it as a
double-quoted escape, and the summary echoes the raw tab.

-- fixtures/cwd/plan.md --
---
title: Foo
---
# Body
-- cmd --
booping frontmatter-update plan.md 'summary=a	b'
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,4 +1,5 @@
 ---
 title: Foo
+summary: "a\tb"
 ---
 # Body
-- stderr --
updated plan.md: summary=a	b
-- expected/cwd/plan.md --
---
title: Foo
summary: "a\tb"
---
# Body
