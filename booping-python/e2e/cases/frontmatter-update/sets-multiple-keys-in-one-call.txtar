Multiple key=value pairs in one call each land in the frontmatter.

-- fixtures/cwd/plan.md --
---
title: Foo
status: backlog
---
# Body
-- cmd --
booping frontmatter-update plan.md status=in-progress sp=3

-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,5 +1,6 @@
 ---
 title: Foo
-status: backlog
+status: in-progress
+sp: 3
 ---
 # Body
-- stderr --
updated plan.md: status=in-progress, sp=3
-- expected/cwd/plan.md --
---
title: Foo
status: in-progress
sp: 3
---
# Body
