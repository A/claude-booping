Appending the same value twice is idempotent — the second run produces no diff.

-- fixtures/cwd/plan.md --
---
title: Foo
sessions: null
---
# Plan
-- cmd --
booping frontmatter-update plan.md --append sessions=abc-123
booping frontmatter-update plan.md --append sessions=abc-123
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,5 +1,6 @@
 ---
 title: Foo
-sessions: null
+sessions:
+- abc-123
 ---
 # Plan
-- stderr --
updated plan.md: sessions+=abc-123
updated plan.md: sessions+=abc-123
-- expected/cwd/plan.md --
---
title: Foo
sessions:
- abc-123
---
# Plan
