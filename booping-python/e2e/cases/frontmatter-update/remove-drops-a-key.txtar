Removing a key drops its line from the frontmatter and reports the deletion
diff.

-- fixtures/cwd/plan.md --
---
title: Foo
type: feature
business_goal: x
status: backlog
---
# Body
-- cmd --
booping frontmatter-update plan.md --remove business_goal
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,7 +1,6 @@
 ---
 title: Foo
 type: feature
-business_goal: x
 status: backlog
 ---
 # Body
-- stderr --
updated plan.md: -business_goal
-- expected/cwd/plan.md --
---
title: Foo
type: feature
status: backlog
---
# Body
