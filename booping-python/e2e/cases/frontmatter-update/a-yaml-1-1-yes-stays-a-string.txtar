The YAML 1.1 boolean word yes stays a string, written single-quoted so it reloads as a string.

-- fixtures/cwd/plan.md --
---
status: draft
sp: 0
---

Body.
-- cmd --
booping frontmatter-update plan.md summary=yes
-- stdout --
--- plan.md
+++ plan.md
@@ -1,6 +1,7 @@
 ---
 status: draft
 sp: 0
+summary: 'yes'
 ---
 
 Body.
-- stderr --
updated plan.md: summary=yes
-- expected/cwd/plan.md --
---
status: draft
sp: 0
summary: 'yes'
---

Body.
-- exit --
0
