Setting multiple keys in a single call applies all updates in one diff.

-- fixtures/cwd/plan.md --
---
title: Foo
status: backlog
---
# Body
-- cmd --
booping frontmatter-update plan.md status=in-progress sp=8
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,5 +1,6 @@
 ---
 title: Foo
-status: backlog
+status: in-progress
+sp: 8
 ---
 # Body
-- expected/cwd/plan.md --
---
title: Foo
status: in-progress
sp: 8
---
# Body
