A second call with the same pair produces no diff on stdout and exits 0.

-- fixtures/cwd/plan.md --
---
title: Foo
status: backlog
---
# Body
-- cmd --
booping frontmatter-update plan.md status=in-progress
booping frontmatter-update plan.md status=in-progress

-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,5 +1,5 @@
 ---
 title: Foo
-status: backlog
+status: in-progress
 ---
 # Body
-- stderr --
updated plan.md: status=in-progress
updated plan.md: status=in-progress
-- expected/cwd/plan.md --
---
title: Foo
status: in-progress
---
