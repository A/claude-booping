A key=value whose value is a Jinja macro call resolves through the stubbed
macro and lands in the file with the same coercion as a literal value.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
-- fixtures/cwd/vault/config.yaml --
macro_stubs:
  core.macros.count: "5"
-- fixtures/cwd/plan.md --
---
title: Foo
---
# Body
-- cmd --
booping frontmatter-update plan.md "n={{ macro('core.macros.count') }}"
-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,4 +1,5 @@
 ---
 title: Foo
+n: 5
 ---
 # Body
-- stderr --
updated plan.md: n=5
-- expected/cwd/plan.md --
---
title: Foo
n: 5
---
# Body
