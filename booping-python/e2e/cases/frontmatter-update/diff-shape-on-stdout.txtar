The change to the plan file is reported as a unified diff on stdout with --- / +++ / @@ headers.

-- fixtures/cwd/plan.md --
---
title: Foo
status: backlog
---
# Body
-- cmd --
booping frontmatter-update plan.md sp=3

-- exit --
0
-- stdout --
--- plan.md
+++ plan.md
@@ -1,5 +1,6 @@
 ---
 title: Foo
 status: backlog
+sp: 3
 ---
 # Body
-- stderr --
updated plan.md: sp=3
-- expected/cwd/plan.md --
---
title: Foo
status: backlog
sp: 3
---
# Body
