-- fixtures/cwd/vault/codereviews/p/202610151600.md --
---
plan: plans/p/index.md
---

# Review
-- cmd --
booping defaults add --target codereviews/p/202610151600.md --step code-review/resolve --asked "Fix the finding or skip it?" --default "fixed" --why "the step recommends fixing"
-- exit --
0
-- stdout --
codereviews/p/defaults.md#D1
-- stderr --
-- expected/cwd/vault/codereviews/p/defaults.md --
