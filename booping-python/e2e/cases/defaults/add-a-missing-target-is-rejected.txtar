A target that does not exist in the vault is one error line at exit 1: nothing on stdout and no
sidecar written.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/config.yaml --
macro_stubs:
  "core.macros.date +%Y-%m-%d %H:%M": "2026-10-15 16:40"
-- fixtures/cwd/vault/plans/p/index.md --
---
title: P
---

# P
-- cmd --
booping defaults add --target plans/q/index.md --step groom/present --asked "Approve?" --default "approved"
-- exit --
1
-- stdout --
-- stderr --
error: target not found: plans/q/index.md
