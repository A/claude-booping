A window whose end is before its start wraps midnight: 22:00-06:00 is open at 23:30.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/config.yaml --
macro_stubs:
  core.macros.date +%Y-%m-%d %H:%M: "2026-10-15 23:30"
core:
  budget:
    probe:
      - sh
      - -c
      - |
        printf '%s\n' '{"type":"rate_limit_event","rate_limit_info":{"unifiedWindows":{"five_hour":{"utilization":0.42,"resetsAt":1792090800},"seven_day":{"utilization":0.31,"resetsAt":1792573200}}}}'
    window: {start: "22:00", end: "06:00"}
-- cmd --
env BOOPING_RUN_ID=r1 TZ=UTC booping budget gate
-- exit --
0
-- stdout --
allow — 5h 42%, 7d 31%
