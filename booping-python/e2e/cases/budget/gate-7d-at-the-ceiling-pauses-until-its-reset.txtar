A 7-day usage at the ceiling pauses, naming both, with the 7-day reset as `resume_after`.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/config.yaml --
macro_stubs:
  core.macros.date +%Y-%m-%d %H:%M: "2026-10-15 12:00"
core:
  budget:
    probe:
      - sh
      - -c
      - |
        printf '%s\n' '{"type":"rate_limit_event","rate_limit_info":{"unifiedWindows":{"five_hour":{"utilization":0.42,"resetsAt":1792090800},"seven_day":{"utilization":0.85,"resetsAt":1792573200}}}}'
-- cmd --
env BOOPING_RUN_ID=r1 TZ=UTC booping budget gate
-- exit --
3
-- stdout --
pause — 7d usage 85% ≥ ceiling 85%
resume_after: 2026-10-21 09:00
-- stderr --
