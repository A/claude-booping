`budget read` takes the last `rate_limit_event` of the newest run log younger than
`core.budget.max_age_s`, skipping lines that are not JSON, and names the log as its source;
the probe is never run (it would exit 1).

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/config.yaml --
core:
  budget:
    probe: [sh, -c, "exit 1"]
-- fixtures/cwd/vault/runs/r1.log --
starting up
{"type":"rate_limit_event","rate_limit_info":{"unifiedWindows":{"five_hour":{"utilization":0.10,"resetsAt":1792083600},"seven_day":{"utilization":0.20,"resetsAt":1792486800}}}}
{"type":"assistant","message":{"content":[]}}
{"type":"rate_limit_event","rate_limit_info":{"unifiedWindows":{"five_hour":{"utilization":0.42,"resetsAt":1792090800},"seven_day":{"utilization":0.31,"resetsAt":1792573200}}}}
{"type":"result","subtype":"success"}
-- cmd --
env TZ=UTC booping budget read
-- exit --
0
