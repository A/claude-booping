With no runs directory `budget read` runs `core.budget.probe` in the repo and parses the
last `rate_limit_event` of its stdout; the probe's stderr is discarded.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/config.yaml --
core:
  budget:
    probe:
      - sh
      - -c
      - |
        echo 'not json'
        echo 'noise' >&2
        printf '%s\n' '{"type":"rate_limit_event","rate_limit_info":{"unifiedWindows":{"five_hour":{"utilization":0.42,"resetsAt":1792090800},"seven_day":{"utilization":0.31,"resetsAt":1792573200}}}}'
-- cmd --
env TZ=UTC booping budget read
-- exit --
0
-- stdout --
5h: 42% (resets 2026-10-15 19:00)
7d: 31% (resets 2026-10-21 09:00)
source: probe
-- stderr --
