A second run whose date macro gives the same second takes the next free id, `-2`, and its own
session id.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/config.yaml --
macro_stubs:
  core.macros.date +%Y%m%d-%H%M%S: "20261015-120000"
  core.macros.date +%Y-%m-%d %H:%M: "2026-10-15 12:00"
core:
  run:
    command:
      - sh
      - -c
      - |
        printf 'arg: %s\n' "$@"
        echo "env: $CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS"
        if read -r line; then echo "stdin: data"; else echo "stdin: empty"; fi
        exit 0
      - fake
-- fixtures/cwd/vault/plans/p1/index.md --
---
title: P1
status: ready-for-dev
---
-- cmd --
booping run develop vault/plans/p1
booping run develop vault/plans/p1
-- exit --
0
-- stdout --
