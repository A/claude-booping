`run develop --autonomous` passes the budget gate before it allocates a record: outside the
window it prints the verdict, exits 3 and writes no runs directory.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/config.yaml --
macro_stubs:
  core.macros.date +%Y%m%d-%H%M%S: "20261015-120000"
  core.macros.date +%Y-%m-%d %H:%M: "2026-10-15 12:00"
core:
  budget:
    window: {start: "01:00", end: "07:00"}
  run:
    command: [sh, -c, "echo launched"]
-- fixtures/cwd/vault/plans/p1/index.md --
---
title: P1
status: in-progress
---
-- fixtures/cwd/vault/plans/p1/milestones/M01-first/M01-first.md --
---
id: "01"
title: First
status: done
---
-- fixtures/cwd/vault/plans/p1/milestones/M02-second/M02-second.md --
---
id: "02"
title: Second
status: pending
---
-- cmd --
sh -c 'booping run develop vault/plans/p1 --autonomous; echo "exit: $?"; ls vault'
-- exit --
0
-- stdout --
pause — outside window 01:00-07:00
resume_after: 2026-10-16 01:00
exit: 3
config.yaml
plans
