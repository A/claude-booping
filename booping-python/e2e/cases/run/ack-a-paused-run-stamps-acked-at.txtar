`ack` stamps `acked_at` on a paused run from the date macro and leaves the rest as is.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/config.yaml --
macro_stubs:
  core.macros.date +%Y-%m-%d %H:%M: "2026-10-16 09:30"
-- fixtures/cwd/vault/runs/r1.md --
---
id: r1
playbook: develop
mode: supervised
target:
- plans/p1/index.md
plan: plans/p1/index.md
items: []
status: paused
pid: null
session_id: 00000000-0000-0000-0000-000000000000
log: runs/r1.log
started_at: 2026-10-15 12:00
ended_at: 2026-10-15 12:10
exit_code: 0
acked_at: null
paused_reason: outside window 01:00-07:00
resume_after: 2026-10-16 01:00
next_milestone: M02-second
---

# r1
-- cmd --
booping run ack r1
-- exit --
0
-- stdout --
r1: acked
-- stderr --
-- expected/cwd/vault/runs/r1.md --
---
id: r1
playbook: develop
mode: supervised
target:
- plans/p1/index.md
plan: plans/p1/index.md
