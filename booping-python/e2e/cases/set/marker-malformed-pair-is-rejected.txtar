An argument carrying no = is a user error naming the malformed argument, and the marker is
left untouched.

-- fixtures/cwd/.booping --
# booping project marker
project_name: "demo"  # quoted on purpose
vault_path: ./vault
-- cmd --
booping marker-set latest_migration
-- exit --
1
-- stdout --
-- stderr --
error: malformed key=value pair: 'latest_migration'
-- expected/cwd/.booping --
# booping project marker
project_name: "demo"  # quoted on purpose
vault_path: ./vault
