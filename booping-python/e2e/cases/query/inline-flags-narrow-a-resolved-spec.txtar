Inline `--where`, `--sort` and `--columns` merge over the spec `--config` resolved instead of
replacing it: the spec's own `status: done` clause still excludes Alpha, the inline clause
drops Delta on top of it, and the inline ascending sort overrides the spec's descending one.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
-- fixtures/cwd/vault/config.yaml --
core:
  probe_playbook:
    queries:
      done_plans:
        glob:
          - plans/*/index.md
        where:
          status: done
        sort: '-created'
-- fixtures/cwd/vault/plans/alpha/index.md --
---
title: Alpha
status: ready-for-dev
created: 20260101
---

body
-- fixtures/cwd/vault/plans/beta/index.md --
---
title: Beta
status: done
created: 20260303
---

body
-- fixtures/cwd/vault/plans/gamma/index.md --
---
title: Gamma
status: done
created: 20260202
---

body
-- fixtures/cwd/vault/plans/delta/index.md --
---
title: Delta
status: done
created: 20260404
---

body
-- cmd --
booping query --config core.probe_playbook.queries.done_plans --where 'title!=Delta' --sort created --columns title,status
-- exit --
0
-- stdout --
| title | status | path | slug |
| --- | --- | --- | --- |
| Gamma | done | plans/gamma/index.md | gamma |
| Beta | done | plans/beta/index.md | beta |
-- stderr --
