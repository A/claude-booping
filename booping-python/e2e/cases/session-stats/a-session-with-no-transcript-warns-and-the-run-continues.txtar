{"type":"user","isSidechain":false,"origin":{"kind":"human"},"timestamp":"2026-08-01T09:00:00.000Z","message":{"role":"user","content":"go"}}
{"type":"assistant","isSidechain":false,"timestamp":"2026-08-01T09:05:00.000Z","message":{"role":"assistant","model":"claude-fable-5","content":[{"type":"text","text":"ok"}],"usage":{"input_tokens":8,"output_tokens":6,"cache_creation_input_tokens":1,"cache_read_input_tokens":2}}}
