-- fixtures/home/Claude/_playbooks/fx-hooks/_scripts/env-note --
#!/bin/sh
{
  echo "artifact=$BOOPING_ARTIFACT"
  echo "workdir=$BOOPING_WORKDIR"
  echo "cwd=$(pwd)"
} > "$BOOPING_WORKDIR/env.txt"
