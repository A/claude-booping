Tier schemas do not cascade: a global tier's `_schemas/rule.yaml` leaves the project tier on the
shipped rule schema.

-- fixtures/xdg/booping/config.yaml --
core:
  specs:
    tiers:
      global:
        namespace: owner
-- fixtures/home/Claude/_specs/_schemas/rule.yaml --
doc: rule

rules:
  - select: FRONTMATTER
    has:
      type: rule
      title: '^.+$'
      summary: '^.{1,200}$'
      created_by: { enum: [owner, claude] }
      created_at: '^\d{4}-\d{2}-\d{2}$'
      updated_at: '^\d{4}-\d{2}-\d{2}$'
      status: { enum: [accepted, retired] }

  - select: H2
    ordered: [Правило, Следует из ценностей, Исключения?]
    strict: true

  - select: SECTION("Правило") > P
    min: 1

  - select: SECTION("Следует из ценностей") > UL > LI
    min: 1
    each:
      - select: A
        min: 1

  - select: SECTION("Исключения") > UL > LI
    optional: true
    min: 1
-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/rule/0001-keep-it-short.md --
---
type: rule
title: Keep it short
summary: Cut what the reader does not need.
created_by: owner
created_at: 2026-01-01
updated_at: 2026-01-01
status: accepted
---

## Правило

Cut what the reader does not need.

## Следует из ценностей

