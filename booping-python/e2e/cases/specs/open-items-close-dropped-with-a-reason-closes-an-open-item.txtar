`close --dropped --reason` takes an open item straight to `dropped`: the reason is written
first, then the edge stamps `closed_at`.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/config.yaml --
macro_stubs:
  core.macros.date: "2026-10-15"
-- fixtures/cwd/vault/open-items/OI-0001.md --
---
id: OI-0001
title: "Gap OI-0001"
status: open
direction: clarify
record: null
source: manual
plan: null
created_at: 2026-10-01
closed_at: null
reason: null
---

# Gap OI-0001
-- cmd --
booping specs open-items close OI-0001 --dropped --reason "resolved upstream"
-- exit --
0
-- stdout --
open-items/OI-0001.md
frontmatter: reason="resolved upstream"
open → dropped
frontmatter: status=dropped
frontmatter: closed_at=2026-10-15
-- stderr --
-- expected/cwd/vault/open-items/OI-0001.md --
---
id: OI-0001
title: "Gap OI-0001"
status: dropped
direction: clarify
record: null
source: manual
plan: null
created_at: 2026-10-01
closed_at: '2026-10-15'
reason: resolved upstream
---

# Gap OI-0001
