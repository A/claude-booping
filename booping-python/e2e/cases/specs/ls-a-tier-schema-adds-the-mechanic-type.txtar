A type the project tier adds through `_schemas/mechanic.yaml` is listed like a shipped one.

-- fixtures/cwd/.booping --
project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/_schemas/mechanic.yaml --
doc: mechanic

rules:
  - select: FRONTMATTER
    has:
      type: mechanic
      title: '^.+$'
      summary: '^.{1,200}$'
      status: { enum: [draft, accepted] }

  - select: H2
    ordered: [Loop]
    strict: true
-- fixtures/cwd/vault/mechanic/0001-dash.md --
---
type: mechanic
title: Dash
summary: A short burst of speed on a cooldown.
status: accepted
---

## Loop

Press, burst, wait for the cooldown.
