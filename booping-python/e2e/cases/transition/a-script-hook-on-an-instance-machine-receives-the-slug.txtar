-- fixtures/home/Claude/_playbooks/fx-hooks/_scripts/slug-note --
#!/bin/sh
{
  echo "instance=$BOOPING_INSTANCE"
  echo "artifact=$BOOPING_ARTIFACT"
} > "$BOOPING_WORKDIR/slug.txt"
