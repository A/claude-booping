name: fx-hooks
title: Hooks
summary: Hook-bearing fixture for transition.
---

Preamble.
-- fixtures/home/Claude/_playbooks/fx-hooks/playbook.yaml --
state: main
graph:
  only: []
  step-pipeline:
    dependencies: [only]
    state: step
    graph:
      spec: []

states:
  main:
    artifact: index.md
    initial: intaking
    statuses:
      intaking:
        transitions:
          - to: noted
            when: nothing runs here
      noted: {terminal: true}
  step:
    artifact: steps/{instance}/index.md
    initial: spec-ing
    statuses:
      spec-ing:
        transitions:
          - to: done
            when: the slug is recorded
            hooks: ["script slug-note"]
      done: {terminal: true}
