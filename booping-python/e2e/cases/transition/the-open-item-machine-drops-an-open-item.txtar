project_name: probe
vault_path: ./vault
latest_migration: 9999
-- fixtures/cwd/vault/config.yaml --
macro_stubs:
  core.macros.date: "2026-10-15"
-- fixtures/cwd/vault/open-items/OI-0001.md --
---
id: OI-0001
title: "t"
status: open
direction: clarify
record: null
source: manual
plan: null
created_at: 2026-10-15
closed_at: null
reason: null
---

# t
-- cmd --
booping playbook-transition specs dropped --state open_item --instance OI-0001 --workdir vault
-- exit --
0
-- stdout --
open → dropped
frontmatter: status=dropped
frontmatter: closed_at=2026-10-15
