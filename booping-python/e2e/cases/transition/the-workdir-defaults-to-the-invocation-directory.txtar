Without `--workdir` the artifact path resolves against the directory the command runs in.

-- fixtures/home/Claude/_playbooks/fx-run/playbook.md --
---
name: fx-run
title: Run
summary: Hookless states-bearing fixture for playbook-transition.
---

Preamble.
-- fixtures/home/Claude/_playbooks/fx-run/playbook.yaml --
state: main
graph:
  intake: []
  step-pipeline:
    dependencies: [intake]
    state: step
    graph:
      spec: []

states:
  main:
    artifact: index.md
    initial: intaking
    statuses:
      intaking:
        transitions:
          - to: researching
            when: intake complete
          - to: parked
            when: the run is shelved
      researching:
        transitions:
          - to: done
            when: research complete
      parked: {terminal: true}
      done: {terminal: true}
  step:
    artifact: steps/{instance}/index.md
    initial: spec-ing
    statuses:
      spec-ing:
        transitions:
          - to: done
            when: spec written
      done: {terminal: true}
