{% extends "base.html.j2" %}
{% from "_macros.html.j2" import record_row, filter_bar %}
{% block scripts %}
<script src="{{ prefix }}filter-format.js" defer></script>
<script src="{{ prefix }}filter.js" defer></script>
{% endblock %}
{% block main %}
<h1>{{ heading }}</h1>
{{ filter_bar(filters, labels, "entries_shown", "filters_show_entries") | trim }}
<ul class="rows">
{% for row in rows %}
{{ record_row(row, labels, prefix) | trim }}
{% endfor %}
</ul>
{% endblock %}
