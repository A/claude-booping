{% extends "base.html.j2" %}
{% from "_macros.html.j2" import callout, scenarios, recently_updated %}
{% block main %}
<div class="measure">
<h1>{{ site_title }}</h1>
{% if lead is not none %}
<p class="lead">{{ lead }}</p>
{% endif %}
{% if needs %}
{{ callout(needs, unreviewed, questions, "review.html") | trim }}
{% endif %}
</div>
{{ scenarios(types) | trim }}
{% if recent %}
{{ recently_updated(recent) | trim }}
{% endif %}
{% endblock %}
