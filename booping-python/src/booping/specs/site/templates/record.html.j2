{% extends "base.html.j2" %}
{% from "_macros.html.j2" import state_badges, fact_item, fact_value, rel_item, toc_blocks %}
{% block head %}
<link rel="alternate" type="text/markdown" href="{{ record.stem }}.md">
{% endblock %}
{% block rail %}
{% if record.toc or record.questions %}
{{ toc_blocks(record, labels, "rail") | trim }}
{% endif %}
{% endblock %}
{% block main %}
{% set r = record %}
<div class="measure">
<article>
<h1>{{ r.title }}</h1>
{% set badges = state_badges(r.state, labels, clarify_href=("#" ~ r.state.first_mark) if r.state.first_mark else none) | trim %}
{% if badges %}
<div class="badges">{{ badges }}</div>
{% endif %}
{% if r.tags %}
<div class="tags">{% for tag in r.tags %}{% if not loop.first %} {% endif %}{% if tag.href is not none %}<a class="tag" href="{{ tag.href }}">#{{ tag.text }}</a>{% else %}<span class="tag">#{{ tag.text }}</span>{% endif %}{% endfor %}</div>
{% endif %}
{% if r.summary is not none %}
<p class="lead">{{ r.summary }}</p>
{% endif %}
{% if r.toc or r.questions %}
<details class="toc-m">
<summary>{{ labels.ui("on_this_page") }}{% if r.questions %} · {{ labels.plural("open_questions", r.questions | length) }}{% endif %}</summary>
{{ toc_blocks(r, labels, "toc-m") | trim }}
</details>
{% endif %}
{% if r.facts or r.relations %}
<dl class="facts">
{% for fact in r.facts %}
<dt>{{ fact.label }}</dt>
<dd>{% for item in fact["items"] %}{% if not loop.first %}, {% endif %}{{ fact_value(item) }}{% endfor %}</dd>
{% endfor %}
{% for row in r.relations %}
<dt>{{ row.label }}</dt>
<dd><ul class="rel">
{% for item in row["items"] %}
<li>{{ rel_item(item) }}</li>
{% endfor %}
</ul></dd>
{% endfor %}
</dl>
{% endif %}
{% if r.raw %}
<dl class="facts">
{% for fact in r.raw %}
<dt>{{ fact.key }}</dt>
<dd>{% for item in fact["items"] %}{% if not loop.first %}, {% endif %}{{ fact_item(item) }}{% endfor %}</dd>
{% endfor %}
</dl>
{% endif %}
<div class="body">
{{ r.body }}</div>
</article>
<h2 id="referenced-by">{{ labels.ui("referenced_by") }}<a class="anchor" href="#referenced-by" aria-label="{{ labels.ui('section_link') }}: {{ labels.ui('referenced_by') }}">§</a></h2>
{% if r.backlinks.by_type %}
{% for group in r.backlinks.by_type %}
<h3>{{ group.label }}</h3>
<ul class="rel backlinks">
{% for b in group["items"] %}
<li>{{ rel_item(b.item) }}{% if b.via %} <span class="via">{{ labels.ui("via") }} {{ b.via | join(", ") }}</span>{% endif %}</li>
{% endfor %}
</ul>
{% endfor %}
{% if r.backlinks.by_section %}
<h3>{{ labels.ui("by_section") }}</h3>
<ul class="rel by-section">
{% for section in r.backlinks.by_section %}
<li><a href="#{{ section.heading.id }}">{{ section.heading.text }}</a> ← {% for src in section.sources %}{% if not loop.first %}, {% endif %}<a href="{{ src.href }}"><code class="ref">{{ src.ref }}</code></a>{% endfor %}</li>
{% endfor %}
</ul>
{% endif %}
{% else %}
<p>{{ labels.ui("nothing_references") }}</p>
{% endif %}
</div>
{% endblock %}
