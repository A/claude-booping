{% extends "base.html.j2" %}
{% from "_macros.html.j2" import state_badges, fact_item, fact_value, rel_item %}
{% block head %}
<link rel="alternate" type="text/markdown" href="{{ record.stem }}.md">
{% endblock %}
{% block main %}
{% set r = record %}
<article>
<h1>{{ r.title }}</h1>
{% set badges = state_badges(r.state, labels, clarify_href=("#" ~ r.state.first_mark) if r.state.first_mark else none) | trim %}
{% if badges %}
<div class="badges">{{ badges }}</div>
{% endif %}
{% if r.tags %}
<div class="tags">{% for tag in r.tags %}{% if not loop.first %} {% endif %}{% if tag.href is not none %}<a class="tag" href="{{ tag.href }}">#{{ tag.text }}</a>{% else %}<span class="tag">#{{ tag.text }}</span>{% endif %}{% endfor %}</div>
{% endif %}
{% if r.summary is not none %}
<p class="lead">{{ r.summary }}</p>
{% endif %}
{% if r.facts %}
<dl class="facts">
{% for fact in r.facts %}
<dt>{{ fact.label }}</dt>
<dd>{% for item in fact["items"] %}{% if not loop.first %}, {% endif %}{{ fact_value(item) }}{% endfor %}</dd>
{% endfor %}
</dl>
{% endif %}
{% if r.relations %}
<section class="relations">
<dl>
{% for row in r.relations %}
<dt>{{ row.label }}</dt>
<dd><ul class="rel">
{% for item in row["items"] %}
<li>{{ rel_item(item) }}</li>
{% endfor %}
</ul></dd>
{% endfor %}
</dl>
</section>
{% endif %}
{% if r.raw %}
<dl class="facts">
{% for fact in r.raw %}
<dt>{{ fact.key }}</dt>
<dd>{% for item in fact["items"] %}{% if not loop.first %}, {% endif %}{{ fact_item(item) }}{% endfor %}</dd>
{% endfor %}
</dl>
{% endif %}
<div class="body">
{{ r.body }}</div>
</article>
<h2 id="referenced-by">{{ labels.ui("referenced_by") }}</h2>
{% if r.backlinks %}
<ul class="rel backlinks">
{% for item in r.backlinks %}
<li>{{ rel_item(item) }}</li>
{% endfor %}
</ul>
{% else %}
<p>{{ labels.ui("nothing_references") }}</p>
{% endif %}
{% endblock %}
