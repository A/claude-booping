{% macro fact_item(item) %}
{%- if item.href is not none -%}
<a href="{{ item.href }}"><code>{{ item.text }}</code></a>
{%- elif item.code -%}
<code{% if item.css is not none %} class="{{ item.css }}"{% endif %}>{{ item.text }}</code>
{%- else -%}
{{ item.text }}
{%- endif -%}
{% endmacro %}

{% macro icon(id) %}<svg class="ic" aria-hidden="true"><use href="#{{ id }}"/></svg>{% endmacro %}

{% macro badge(css, icon_id, text) %}<span class="b {{ css }}">{{ icon(icon_id) }}{{ text }}</span>{% endmacro %}

{% macro state_badges(state, labels, hide_unreviewed=false, clarify_href=none) %}
{%- set css = {"accepted": "ok", "done": "ok", "live": "ok", "resolved": "ok", "proposed": "warn", "planned": "warn", "validating": "warn", "open": "info"} -%}
{%- set icons = {"accepted": "i-accepted", "done": "i-accepted", "live": "i-accepted", "resolved": "i-accepted", "proposed": "i-planned", "planned": "i-planned", "validating": "i-planned", "deferred": "i-planned", "open": "i-open", "rejected": "i-rejected", "retired": "i-rejected", "superseded": "i-rejected"} -%}
{%- if state.status -%}
{{ badge(css.get(state.status, "plain"), icons.get(state.status, "i-open"), labels.status(state.status)) }}
{%- endif -%}
{%- if state.clarify and clarify_href is not none -%}
<a href="{{ clarify_href }}">{{ badge("warn", "i-clarify", labels.plural("clarify", state.clarify)) }}</a>
{%- elif state.clarify -%}
{{ badge("warn", "i-clarify", labels.plural("clarify", state.clarify)) }}
{%- endif -%}
{%- if state.unknown -%}
{{ badge("bad", "i-unknown", labels.ui("unknown")) }}
{%- endif -%}
{%- if state.unreviewed and not hide_unreviewed -%}
{{ badge("plain", "i-unreviewed", labels.ui("unreviewed")) }}
{%- endif -%}
{% endmacro %}

{% macro rel_item(item) %}
{%- if item.href is not none -%}
<a href="{{ item.href }}">{{ item.title }}</a> <code class="ref">{{ item.ref }}</code>{% if item.state.status %} {{ state_badges(item.state, labels) }}{% endif %}
{%- else -%}
<code{% if item.css is not none %} class="{{ item.css }}"{% endif %}>{{ item.text }}</code>
{%- endif -%}
{% endmacro %}

{% macro fact_value(item) %}
{%- if item.datetime is not none -%}
<time datetime="{{ item.datetime }}">{{ item.text }}</time>
{%- elif item.href is not none -%}
<a href="{{ item.href }}">{{ item.text }}</a>
{%- else -%}
{{ item.text }}
{%- endif -%}
{% endmacro %}

{% macro types_list(types, base) %}
<ul class="types">
{% for t in types %}
<li><a href="{{ base }}{{ t.type }}/index.html">{{ labels.type_plural(t.type) }}</a> <span class="n">{{ labels.ui("records") }}: {{ t.count }}</span>
{% set scenario = labels.scenario(t.type) %}
{% if scenario %}
<p>{{ scenario }}</p>
{% endif %}
</li>
{% endfor %}
</ul>
{% endmacro %}
