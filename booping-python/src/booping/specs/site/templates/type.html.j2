{% extends "base.html.j2" %}
{% from "_macros.html.j2" import record_block, status_badge %}
{% block main %}
<h1>{{ type }} <span class="count">{{ records | length }}</span></h1>
<ul class="contents">
{% for r in records %}
<li><code>{{ r.ref }}</code> <a href="#{{ r.stem }}">{{ r.title }}</a>{% if r.badge is not none %} {{ status_badge(r.badge) }}{% endif %}</li>
{% endfor %}
</ul>
{% for r in records %}
<article id="{{ r.stem }}">
{{ record_block(r, 2) }}
</article>
{% endfor %}
{% endblock %}
