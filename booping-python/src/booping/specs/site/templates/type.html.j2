{% extends "base.html.j2" %}
{% from "_macros.html.j2" import record_row, filter_bar %}
{% block scripts %}
<script src="{{ prefix }}filter.js" defer></script>
{% endblock %}
{% block main %}
<h1>{{ labels.type_plural(type) }}</h1>
{% set scenario = labels.scenario(type) %}
{% if scenario %}
<p class="lead">{{ scenario }}</p>
{% endif %}
{{ filter_bar(filters, labels) | trim }}
<ul class="rows">
{% for row in rows %}
{{ record_row(row, labels, prefix) | trim }}
{% endfor %}
</ul>
{% endblock %}
