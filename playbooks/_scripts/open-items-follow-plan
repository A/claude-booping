#!/bin/sh
# Shared hook: open items follow the plan they are linked to.
#
#   open-items-follow-plan done  — close the plan's planned items as done
#   open-items-follow-plan open  — return the plan's planned items to open
#
# Wired onto develop's `→ done`, `→ fail` and `→ cancelled` edges and groom's
# `→ cancelled` edges. Environment (set by `booping playbook-transition`):
# BOOPING_ARTIFACT = the plan's `index.md`, absolute; the CLI turns it into the
# vault-relative `plan:` the items carry.
#
# The CLI's exit code is absorbed on purpose: a hook exiting non-zero aborts
# `playbook-transition` *after* `status:` is already written, which would leave the
# plan advanced and its items behind with no way back. A failed follow is a
# warning; `booping specs open-items close|reopen --plan …` by hand is the reconcile.
#
# The binary is resolved from this script's own location — cwd is the plan
# directory, so a relative path would miss.
set -u

BOOPING="${BOOPING_BIN:-$(cd "$(dirname "$0")/../.." && pwd)/bin/booping}"

case "${1:-}" in
    done) verb=close ;;
    open) verb=reopen ;;
    *)
        echo "warning: open-items follow-plan: unknown argument '${1:-}' (want done|open)" >&2
        exit 0
        ;;
esac

"$BOOPING" specs open-items "$verb" --plan "${BOOPING_ARTIFACT:-}"
status=$?
if [ "$status" -ne 0 ]; then
    echo "warning: open-items follow-plan failed (exit $status)" >&2
fi

exit 0
