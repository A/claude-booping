#!/usr/bin/env python3
"""Shared hook: stamp mined active minutes, tokens and model ids onto the run's artifact.

Used by the `develop` playbook on its close edges, after `stamp-session`, so the
closing session's own minutes are counted.

Environment (set by `booping playbook-transition`): BOOPING_ARTIFACT = the run's
resolved target, the plan's `index.md`.

Losing a metric must never block a close, so any failure of the compute is a
warn-to-stderr no-op rather than a failed transition.
"""

import os
import subprocess
import sys
from pathlib import Path

BOOPING = Path(__file__).resolve().parents[2] / "bin" / "booping"


def main() -> None:
    artifact = os.environ.get("BOOPING_ARTIFACT", "")
    if not artifact:
        sys.exit("stamp-active-time: BOOPING_ARTIFACT unset")

    plan_dir = str(Path(artifact).resolve().parent)
    result = subprocess.run([str(BOOPING), "session-stats", plan_dir, "--force"], check=False)
    if result.returncode != 0:
        print(
            f"stamp-active-time: session-stats exited {result.returncode}; nothing stamped",
            file=sys.stderr,
        )


if __name__ == "__main__":
    main()
