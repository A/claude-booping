#!/usr/bin/env python3
"""Exit hook for the `learn` playbook's `awaiting-learning → done` edge.

Environment (set by `booping playbook-transition`): BOOPING_WORKDIR =
{vault}/plans/{primary-slug}, which is also cwd.

Reads the working set out of the workdir's `retro.md` (`plans:`), sets
`status: done` on every plan other than the primary (the primary's own status is
written by `playbook-transition` before the hooks run), re-renders the vault's
sprints.md and commits — staging `_lessons/` and `_booping/` so the files the
run wrote land in the same commit. Self-contained: the vault carries no
`.booping` marker, so nothing here shells back into `booping`, and nothing
outside the standard library is imported.

A `retro.md` without a `plans:` list, or a listed plan file that is missing,
exits non-zero, which aborts the transition.
"""

import os
import re
import subprocess
import sys
from pathlib import Path

FRONTMATTER = re.compile(r"\A---\n(.*?)\n---\n", re.DOTALL)


def _clean(value: str) -> str:
    return value.split("  #")[0].strip().strip("\"'")


def read_frontmatter(path: Path) -> dict[str, object]:
    """Minimal block-style YAML frontmatter reader: scalars, block lists, and
    one level of nested mapping — the shapes retro.md and the plans actually use."""
    match = FRONTMATTER.match(path.read_text())
    if not match:
        return {}

    fm: dict[str, object] = {}
    key: str | None = None
    lines = match.group(1).splitlines()
    for line in lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line.startswith((" ", "\t")):
            if key is None:
                continue
            item = line.strip()
            if item.startswith("- "):
                fm.setdefault(key, [])
                target = fm[key]
                if isinstance(target, list):
                    target.append(_clean(item[2:]))
            elif ":" in item:
                fm.setdefault(key, {})
                target = fm[key]
                if isinstance(target, dict):
                    name, _, value = item.partition(":")
                    target[name.strip()] = _clean(value)
            continue
        if ":" not in line:
            continue
        key, _, value = line.partition(":")
        key = key.strip()
        value = _clean(value)
        if value:
            fm[key] = value
            key = None
    return fm


def stamp(plan: Path, values: dict[str, str]) -> None:
    text = plan.read_text()
    if not text.startswith("---\n"):
        sys.exit(f"plan has no frontmatter: {plan}")
    head, sep, body = text.partition("\n---\n")
    for key, value in values.items():
        pattern = rf"^{re.escape(key)}:.*$"
        if re.search(pattern, head, re.MULTILINE):
            head = re.sub(pattern, f"{key}: {value}", head, count=1, flags=re.MULTILINE)
        else:
            head += f"\n{key}: {value}"
    plan.write_text(head + sep + body)


def discover_plans(vault: Path) -> list[tuple[str, Path]]:
    """Mixed-shape discovery: a directory plan (`plans/{slug}/index.md`, else the
    legacy `plan.md`) shadows a same-slug flat `plans/{slug}.md`."""
    plans_dir = vault / "plans"
    by_slug: dict[str, Path] = {}
    for pattern in ("*/index.md", "*/plan.md"):
        for path in plans_dir.glob(pattern):
            by_slug.setdefault(path.parent.name, path)
    for path in plans_dir.glob("*.md"):
        by_slug.setdefault(path.stem, path)
    return sorted(by_slug.items())


CELL = str.maketrans({"|": "\\|", "\n": " "})
COLUMNS = ("status", "sp", "title", "summary", "created", "planned", "completed", "retro")


def render_sprints(vault: Path) -> int:
    rows: list[tuple[str, list[str]]] = []
    for _, path in discover_plans(vault):
        fm = read_frontmatter(path)
        cells = [str(fm.get(key, "") or "").translate(CELL) for key in COLUMNS]
        cells.append(str(path.relative_to(vault)))
        rows.append((str(fm.get("created", "") or ""), cells))

    with_date = sorted((r for r in rows if r[0]), key=lambda r: r[0], reverse=True)
    without_date = [r for r in rows if not r[0]]

    lines = [
        "<!-- Snapshot generated by booping render-sprints; regenerated by /chat on each orient. Do not hand-edit. -->",
        "| " + " | ".join((*COLUMNS, "path")) + " |",
        "| " + " | ".join(["---"] * (len(COLUMNS) + 1)) + " |",
    ]
    lines += ["| " + " | ".join(cells) + " |" for _, cells in with_date + without_date]
    (vault / "sprints.md").write_text("\n".join(lines) + "\n")
    return len(rows)


def main() -> None:
    workdir = Path(os.environ.get("BOOPING_WORKDIR", ".")).resolve()
    primary_slug = workdir.name
    vault = workdir.parent.parent

    retro = workdir / "retro.md"
    if not retro.is_file():
        sys.exit(f"retrospective not found: {retro}")

    fm = read_frontmatter(retro)
    plans = fm.get("plans")
    if not isinstance(plans, list) or not plans:
        sys.exit(f"{retro}: frontmatter carries no `plans:` list")

    primary_rel = {f"plans/{primary_slug}/index.md", f"plans/{primary_slug}/plan.md"}

    targets: list[tuple[str, Path]] = []
    for rel in plans:
        path = vault / rel
        if not path.is_file():
            sys.exit(f"{retro}: plan listed in `plans:` not found: {path}")
        if rel not in primary_rel:
            targets.append((rel, path))

    for _, path in targets:
        stamp(path, {"status": "done"})

    count = render_sprints(vault)
    summary = f"working set closed, {len(plans)} plans"
    if targets:
        summary += "; " + ", ".join(f"{rel} → done" for rel, _ in targets)
    summary += f"; sprints.md: {count} plans"

    if (vault / ".git").exists():
        stage = ["sprints.md", *(rel for rel in plans if isinstance(rel, str))]
        for extra in ("_lessons", "_booping"):
            if (vault / extra).exists():
                stage.append(extra)
        subprocess.run(["git", "-C", str(vault), "add", *stage], check=True)
        result = subprocess.run(
            ["git", "-C", str(vault), "commit", "-q", "-m", f"learn: {primary_slug} → done"],
        )
        summary += "; vault-commit: " + ("ok" if result.returncode == 0 else "nothing to commit")

    print(f"close-working-set: {summary}")


if __name__ == "__main__":
    main()
